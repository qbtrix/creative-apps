#!/usr/bin/env bash
# scripts/ci [--changed [BASE]]: the one gate. Runs the no-crash lint, the
# app-state rule, the design lint, the C4 ownership check, the duplicate-code
# check, the CI scripts' fixture tests, the journey quarantine check, the
# mutation anchors, swift build of every target with its tests, and swift
# test, then prints PASS or FAIL and exits with the real status. swift build takes its dependencies only
# from the committed Package.resolved (--force-resolved-versions): a
# Package.swift whose creative-core revision doesn't match it fails here
# instead of re-resolving (scripts/bump-core moves both). A swift test that
# dies without its "Test run with" summary prints TEST PROCESS DIED and the
# tests it left unfinished (scripts/test-died). CI runs plain scripts/ci on
# Linux and macOS. On Linux, Package.swift declares only the Model targets, so
# build and test cover those; on macOS they cover everything.
#
# --changed is what builders run before a PR: every lint and the same build,
# then only the tests of the targets the branch touched since its merge base
# with BASE (default origin/dev), uncommitted and untracked files included
# (scripts/test-scope changed maps paths to tests). Neither mode runs the
# perf and timing tests in Tests/perf-suites.txt; CI's Perf step does.
#
# The no-crash lint fails on crash-prone constructs in Sources/ (tests exempt):
#   try!  as!  fatalError(  preconditionFailure(  precondition(  unowned  .first!  .last!
#
# The app-state rule keeps views dumb: files under Sources/*App/ may read their
# Model and call its methods, never write its state. Each App names its Model
# value `model`, and the rule fails on any line there that
#   - assigns through it:        model.x = ...   model.x += ...   model = ...
#   - binds to it:               $model   $model.x
#   - mutates a collection in it: model.items.append(...) / insert / remove... / toggle / sort
# (the `@State private var model = ...` declaration is allowed). The Model
# targets also keep stored state `private(set)`, so the compiler backs this up.
#
# The design lint enforces docs/design.md "Component order": system components
# first, then SuiteUI, never a hand-rolled look-alike. Comment lines are skipped.
#   apps (Sources/*App/) fail on
#     raw color      Color(red: / hue: / white:  Color(.sRGB / .displayP3  Color(#  #colorLiteral  NSColor(  UIColor(
#     custom font    .font(.custom(  Font.custom(  .system(size: <number>
#     literal size   cornerRadius: <number>  .cornerRadius(<number>)  .padding([edges,] <number>)
#                    .frame(...: <number>)  ...ColumnWidth(<number>)
#     hand-made glass  .blur(radius:  NSVisualEffectView  any Material
#     look-alike     a struct named *Button, *Slider, *Toggle, *Picker, *Stepper, *Sidebar
#     inspector switch  in an inspector file (named *Inspector*, or using an
#                    Inspector...Row), more Toggle( than .toggleStyle(.checkbox):
#                    inspectors use checkboxes, never switches (Pro density)
#   SuiteUI fails on the raw color, custom font and literal size rules outside
#   Tokens.swift, and on .blur(radius: / .background(.ultraThin /
#   NSVisualEffectView outside Glass.swift. Before scanning, the step runs a
#   self-test: fixture lines it must catch and token lines it must let pass.
#
# The C4 ownership check keeps the C4 model current for orientation: every
# Sources/**/*.swift file must be owned by exactly one component's `paths`
# entry (a file, a folder prefix or a glob). Tests/ is not scanned. It reads
# the model scripts/c4-assemble builds from docs/c4/parts/ (a PR edits parts;
# docs/c4/model.json is generated on dev), so it fails first when the parts
# don't assemble. It needs jq and python3 and runs a self-test on a scratch
# tree first.
#
# The waves check runs scripts/waves: every app's feature data
# (docs/blueprints/*/features/*.wave.json) passes its checks and prints its
# waves.md without writing it (the generated files are written only on dev),
# and Tests/generated tests scripts/c4-assemble and scripts/waves on fixtures.
#
# The fixture tests: Tests/contact_sheet, audit_lower, test_died, jetsam,
# test_scope and bump_core test the scripts of the same names (some need jq).
#
# The journey quarantine check runs Tests/quarantine, then scripts/quarantine
# check on UITests/quarantine.json: every entry names a journey that exists in
# UITests/, an owner issue (#<number>, open when gh can tell), a reason, and
# an expiry no more than 7 days out that hasn't passed. scripts/ui-test skips
# the live entries. Needs jq.
#
# The mutation anchors check runs Tests/mutate, then scripts/mutate --validate:
# every `find` in Tests/mutations/*.json occurs exactly once in its file, so a
# refactor can't leave a plan that plants nothing and still reads as covered.
# It builds nothing; running the mutations (scripts/mutate) is a builder's step.
#
# The duplicate check runs jscpd (pinned) over Sources/ and fails when duplicated
# lines exceed JSCPD_THRESHOLD percent. It starts at creative-core's threshold
# and only ever goes down: lower it when you remove a clone, never raise it.
# Without npx, or when npm can't fetch jscpd, the check prints SKIP and the gate
# goes on; CI enforces it.
#
# On a Mac with only the Command Line Tools (no Xcode), Swift Testing lives in
# a framework directory swift does not search by default, so we add it.
# bash 3.2 compatible (macOS /bin/bash).
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

fail() { echo; echo "CI: FAIL ($1)"; exit 1; }

changed_mode=0
case "${1:-}" in
  "") ;;
  --changed) changed_mode=1 base=${2:-origin/dev} ;;
  *) echo "usage: scripts/ci [--changed [BASE]]   (BASE defaults to origin/dev)" >&2; exit 2 ;;
esac
if (( changed_mode )); then
  fork=$(git merge-base "$base" HEAD 2>/dev/null) || fail "--changed: $base has no merge base with HEAD (git fetch origin first?)"
  changed=$( { git diff --name-only "$fork"; git ls-files --others --exclude-standard; } | sort -u)
fi

echo "== no-crash lint (Sources/)"
pattern='try!|as!|fatalError\(|preconditionFailure\(|precondition\(|unowned |\.first!|\.last!'
if grep -rnE "$pattern" Sources/; then
  fail "no-crash lint: replace the lines above with throwing code"
fi
echo "ok"

echo "== app-state rule (Sources/*App/)"
id='[A-Za-z_][A-Za-z0-9_]*'
writes="(^|[^A-Za-z0-9_.\$])(self\.)?model(\.$id)*[[:space:]]*[-+*/%]?=([^=]|\$)"
binds='\$model([^A-Za-z0-9_]|$)'
mutators="(^|[^A-Za-z0-9_.])(self\.)?model(\.$id)+\.(append|insert|remove$id|removeAll|toggle|sort|reverse)\("
if hits=$(grep -rnE "$writes|$binds|$mutators" Sources/*App/ 2>/dev/null \
    | grep -vE "(var|let)[[:space:]]+model[[:space:]]*(:|=)"); then
  echo "$hits"
  fail "app-state rule: views must change state through their Model's methods; add one there"
fi
echo "ok"

echo "== design lint (Sources/*App/, Sources/SuiteUI/)"
raw_color='Color\((red|hue|white):|Color\(\.(sRGB|displayP3)|Color\(#|#colorLiteral|(NS|UI)Color\('
custom_font='\.font\(\.custom\(|Font\.custom\(|(\.font\(\.|Font\.)system\(size:[[:space:]]*[0-9]'
literal_size='cornerRadius[:(][[:space:]]*[0-9]|\.padding\(([^)]*,)?[[:space:]]*[0-9]|\.frame\([^)]*:[[:space:]]*[0-9]|ColumnWidth\(([^)]*[:,])?[[:space:]]*[0-9]'
handmade_glass='\.blur\(radius:|\.background\(\.ultraThin|NSVisualEffectView'
lookalike='struct[[:space:]]+[A-Za-z0-9_]*(Button|Slider|Toggle|Picker|Stepper|Sidebar)([^A-Za-z0-9_]|$)'
toggle='(^|[^A-Za-z0-9_])Toggle\('
checkbox='\.toggleStyle\(\.checkbox\)'
# hits RULE REGEX DIR [grep args]: "path:line: content (RULE)" per non-comment hit.
hits() {
  grep -rnHE --include='*.swift' "${@:4}" -e "$2" "$3" 2>/dev/null \
    | grep -vE '^[^:]*:[0-9]+:[[:space:]]*(//|/?\*)' | sed "s/\$/  ($1)/"
}
# inspector_switches APP: every Toggle( in APP's inspector files (named
# *Inspector*, or using an Inspector...Row) whose file has more Toggles than
# .toggleStyle(.checkbox). Counting per file catches a style on the next line.
inspector_switches() {
  local f code
  { find "$1" -name '*Inspector*.swift'; grep -rlE --include='*.swift' 'Inspector[A-Za-z]*Row' "$1"; } 2>/dev/null \
    | sort -u | while IFS= read -r f; do
      code=$(grep -vE '^[[:space:]]*(//|/?\*)' "$f")
      if (( $(grep -cE "$toggle" <<<"$code") > $(grep -cE "$checkbox" <<<"$code") )); then
        hits "switch in an inspector: add .toggleStyle(.checkbox)" "$toggle" "$f"
      fi
    done
}
# design_lint ROOT: every design-rule hit under ROOT/Sources; nothing when clean.
design_lint() {
  local app s="$1/Sources"
  for app in "$s"/*App; do
    hits "raw color: use SuiteColor" "$raw_color" "$app"
    hits "custom font: use SuiteFont or a system text style" "$custom_font" "$app"
    hits "literal size: use SuiteSpacing, SuiteRadius or SuiteSize" "$literal_size" "$app"
    hits "hand-made glass: use SuiteUI's GlassPanel or ToolbarGroup" "$handmade_glass|Material" "$app"
    hits "look-alike control: use the system control" "$lookalike" "$app"
    inspector_switches "$app"
  done
  hits "raw value outside Tokens.swift" "$raw_color|$custom_font|$literal_size" "$s/SuiteUI" --exclude=Tokens.swift
  hits "glass outside Glass.swift" "$handmade_glass" "$s/SuiteUI" --exclude=Glass.swift
}
# Self-test: each "dir/file|line" fixture alone in a scratch tree.
must_catch=(
  'XApp/V.swift|.foregroundStyle(Color(red: 1, green: 0.5, blue: 0))'
  'XApp/V.swift|Color(hue: 0.5, saturation: 1, brightness: 1)'
  'XApp/V.swift|.fill(Color(white: 0.2))'
  'XApp/V.swift|Color(.sRGB, red: 1, green: 1, blue: 1)'
  'XApp/V.swift|Color(#colorLiteral(red: 1, green: 0, blue: 0, alpha: 1))'
  'XApp/V.swift|Color(nsColor: NSColor(calibratedRed: 1, green: 0, blue: 0, alpha: 1))'
  'XApp/V.swift|let c = UIColor(red: 1, green: 0, blue: 0, alpha: 1)'
  'XApp/V.swift|.font(.custom("Avenir", size: 13))'
  'XApp/V.swift|Text("x").font(Font.custom("Avenir", size: 13))'
  'XApp/V.swift|.font(.system(size: 13, weight: .bold))'
  'XApp/V.swift|.cornerRadius(8)'
  'XApp/V.swift|.background(.red, in: RoundedRectangle(cornerRadius: 12))'
  'XApp/V.swift|.clipShape(.rect(cornerRadius: 6))'
  'XApp/V.swift|.padding(8)'
  'XApp/V.swift|.padding(.horizontal, 10)'
  'XApp/V.swift|.frame(width: 32, height: 32)'
  'XApp/V.swift|.frame(maxWidth: .infinity, minHeight: 300)'
  'XApp/V.swift|.inspectorColumnWidth(min: 220, ideal: 260)'
  'XApp/V.swift|.blur(radius: 20)'
  'XApp/V.swift|.background(.ultraThinMaterial)'
  'XApp/V.swift|.background(.regularMaterial, in: Capsule())'
  'XApp/V.swift|struct PlayButton: View {'
  'XApp/V.swift|private struct LayerSidebar<Row: View>: View {'
  'XApp/V.swift|struct OpacityStepper: View {'
  'XApp/LayerInspector.swift|Toggle("Enabled", isOn: on).toggleStyle(.switch)'
  'XApp/LayerInspector.swift|Toggle("Enabled", isOn: on)'
  'XApp/V.swift|InspectorRow("") { Toggle("Locked", isOn: on) }'
  'SuiteUI/Panel.swift|.frame(width: 32, height: 32)'
  'SuiteUI/Panel.swift|.fill(Color(red: 1, green: 0, blue: 0))'
  'SuiteUI/Panel.swift|.background(.ultraThinMaterial)'
)
must_pass=(
  'XApp/V.swift|.padding(SuiteSpacing.m)'
  'XApp/V.swift|.padding(.horizontal, SuiteSpacing.l)'
  'XApp/V.swift|.padding(SuiteSpacing.xxl * 2)'
  'XApp/V.swift|.background(SuiteColor.surface, in: RoundedRectangle(cornerRadius: SuiteRadius.medium))'
  'XApp/V.swift|.frame(maxWidth: .infinity, alignment: .leading)'
  'XApp/V.swift|.font(.system(.body, design: .monospaced))'
  'XApp/V.swift|Color(nsColor: .separatorColor)'
  'XApp/V.swift|struct ButtonBarHost: View {'
  'XApp/LayerInspector.swift|Toggle("Enabled", isOn: on).toggleStyle(.checkbox)'
  'XApp/LayerInspector.swift|SidebarToggle(id: "v", title: "Visible", onSymbol: "eye", offSymbol: "eye", isOn: on)'
  'XApp/V.swift|Toggle("Hidden", isOn: on)'
  'XApp/V.swift|// Never write Color(red: 1, green: 0, blue: 0) or .ultraThinMaterial here.'
  'SuiteUI/Tokens.swift|public static let artboard = Color(red: 1, green: 1, blue: 1)'
  'SuiteUI/Glass.swift|content.background(.ultraThinMaterial, in: shape)'
)
missed=$(
  t="$(mktemp -d)"
  trap 'rm -rf "$t"' EXIT
  fixture() {
    rm -rf "$t/Sources" && mkdir -p "$t/Sources/${1%%/*}" && printf '%s\n' "${1#*|}" >"$t/Sources/${1%%|*}"
    design_lint "$t"
  }
  for f in "${must_catch[@]}"; do [[ -n "$(fixture "$f")" ]] || echo "not caught: $f"; done
  for f in "${must_pass[@]}"; do got=$(fixture "$f"); [[ -z "$got" ]] || echo "false hit: $got"; done
)
[[ -z "$missed" ]] || { echo "$missed"; fail "design lint self-test: fix the patterns in scripts/ci"; }
found=$(design_lint .)
if [[ -n "$found" ]]; then
  echo "$found"
  fail "design lint: use the system component or a SuiteUI token (docs/design.md, Component order)"
fi
echo "ok"

echo "== C4 ownership (Sources/ vs the model assembled from docs/c4/parts/)"
# c4_unowned ROOT MODEL: "file: why" for each ROOT/Sources/**/*.swift file that
# is not owned by exactly one component in MODEL; nothing when clean.
# A `paths` entry owns a file when it names it, is a folder prefix of it
# (Sources/CoreColor/ or Sources/CoreColor), or is a glob matching it.
c4_unowned() {
  local pairs f id p owners n
  pairs=$(jq -r '.. | objects | select(has("paths")) | .id as $id | .paths[] | "\($id)\t\(.)"' \
    "$2") || { echo "$2: not valid JSON"; return; }
  (cd "$1" && find Sources -name '*.swift' 2>/dev/null | sort) | while IFS= read -r f; do
    owners="" n=0
    while IFS=$'\t' read -r id p; do
      [[ -n "$p" && ", $owners, " != *", $id, "* ]] || continue
      # shellcheck disable=SC2254 # $p is a pattern on purpose
      case "$f" in $p|"${p%/}"/*) owners="$owners${owners:+, }$id"; n=$((n + 1)) ;; esac
    done <<<"$pairs"
    if (( n == 0 )); then echo "$f: no C4 component owns it"
    elif (( n > 1 )); then echo "$f: owned by $n C4 components ($owners)"; fi
  done
}
command -v jq >/dev/null 2>&1 || fail "C4 ownership: jq not found; install jq"
command -v python3 >/dev/null 2>&1 || fail "C4 ownership: python3 not found; install python3"
# Self-test: a scratch tree whose model has every path form, and files it must flag.
c4_got=$(
  t="$(mktemp -d)"
  trap 'rm -rf "$t"' EXIT
  mkdir -p "$t/docs/c4" "$t/Sources/A" "$t/Sources/B" "$t/Sources/C" "$t/Sources/CC" "$t/Sources/G"
  printf '%s\n' '{"model":{"systems":[{"containers":[{"components":[
    {"id":"a","paths":["Sources/A/One.swift","Sources/B/"]},
    {"id":"b","paths":["Sources/C","Sources/B/Two.swift","Sources/G/*.swift"]}]}]}]}}' >"$t/docs/c4/model.json"
  for f in A/One A/Loose B/Two C/Three CC/Four G/Five; do : >"$t/Sources/$f.swift"; done
  c4_unowned "$t" "$t/docs/c4/model.json"
)
c4_want='Sources/A/Loose.swift: no C4 component owns it
Sources/B/Two.swift: owned by 2 C4 components (a, b)
Sources/CC/Four.swift: no C4 component owns it'
if [[ "$c4_got" != "$c4_want" ]]; then
  printf 'want:\n%s\ngot:\n%s\n' "$c4_want" "$c4_got"
  fail "C4 ownership self-test: fix c4_unowned in scripts/ci"
fi
c4_model="$(mktemp)"
if ! python3 scripts/c4-assemble --out "$c4_model"; then
  rm -f "$c4_model"
  fail "C4 parts: docs/c4/parts/ must assemble (scripts/c4-assemble)"
fi
found=$(c4_unowned . "$c4_model")
rm -f "$c4_model"
if [[ -n "$found" ]]; then
  echo "$found"
  fail "C4 ownership: give each file above exactly one owner in docs/c4/parts/ (add it to a component part's paths, or add a component part)"
fi
echo "ok"

echo "== waves (docs/blueprints/*/features/*.wave.json)"
# --dry-run prints nothing to disk: the generated waves.md files are written only on dev.
python3 scripts/waves render --dry-run || fail "waves: fix the feature data above (scripts/waves)"
echo "== generated files (Tests/generated)"
bash Tests/generated/test_generated.sh || fail "generated files: scripts/c4-assemble or scripts/waves broke their tests"

echo "== duplicate code (jscpd, Sources/)"
JSCPD_VERSION=5.3.2
JSCPD_THRESHOLD=0.8
if ! command -v npx >/dev/null 2>&1; then
  echo "SKIP (npx not found; install Node 18+ to run this check)"
elif ! npx --yes "jscpd@$JSCPD_VERSION" --version >/dev/null 2>&1; then
  echo "SKIP (npx could not fetch jscpd@$JSCPD_VERSION from the npm registry)"
else
  JSCPD_NO_TIPS=1 npx --yes "jscpd@$JSCPD_VERSION" --format swift --reporters console \
    --threshold "$JSCPD_THRESHOLD" Sources/ \
    || fail "jscpd: duplicated lines over $JSCPD_THRESHOLD%; move the shared code into SuiteUI or a Model instead of copying it"
fi

echo "== contact sheet (Tests/contact_sheet)"
bash Tests/contact_sheet/test_contact_sheet.sh || fail "contact sheet: scripts/contact-sheet broke its fixture test"
echo "== audit lower (Tests/audit_lower)"
bash Tests/audit_lower/test_audit_lower.sh || fail "audit lower: scripts/audit-lower broke its decision tests"
echo "== test died (Tests/test_died)"
bash Tests/test_died/test_test_died.sh || fail "test died: scripts/test-died broke its fixture test"
echo "== jetsam summary (Tests/jetsam)"
bash Tests/jetsam/test_jetsam_summary.sh || fail "jetsam summary: scripts/jetsam-summary broke its fixture test"
echo "== test scope (Tests/test_scope)"
bash Tests/test_scope/test_test_scope.sh || fail "test scope: scripts/test-scope or Tests/perf-suites.txt broke its tests"
echo "== journey quarantine (UITests/quarantine.json)"
bash Tests/quarantine/test_quarantine.sh || fail "journey quarantine: scripts/quarantine broke its fixture test"
scripts/quarantine check || fail "journey quarantine: fix, renew or remove the entries above (the supervisor edits UITests/quarantine.json)"
echo "== bump core (Tests/bump_core)"
bash Tests/bump_core/test_bump_core.sh || fail "bump core: scripts/bump-core broke its tests"
echo "== mutation anchors (Tests/mutations)"
bash Tests/mutate/test_mutate.sh || fail "mutation anchors: scripts/mutate broke its fixture test"
python3 scripts/mutate --validate || fail "mutation anchors: repoint each find above at the code as it is now (scripts/mutate)"

flags=()
if [[ "$(uname)" == Darwin ]]; then
  clt=/Library/Developer/CommandLineTools/Library/Developer
  if [[ "$(xcode-select -p 2>/dev/null)" == /Library/Developer/CommandLineTools* && -d "$clt/Frameworks/Testing.framework" ]]; then
    flags=(-Xswiftc -F -Xswiftc "$clt/Frameworks" -Xlinker -F -Xlinker "$clt/Frameworks"
           -Xlinker -rpath -Xlinker "$clt/Frameworks" -Xlinker -rpath -Xlinker "$clt/usr/lib")
  fi
fi

echo "== swift build (every target with its tests)"
swift build --build-tests --force-resolved-versions ${flags[@]+"${flags[@]}"} \
  || fail "swift build (an out-of-date Package.resolved means the creative-core pin moved by hand: use scripts/bump-core)"

# run_tests LABEL ARGS...: one `swift test` run on the build above, its wall
# time, and on a failure its cause: a dead test process (no "Test run with"
# summary) names the tests it left running (scripts/test-died).
logs=()
trap 'rm -f ${logs[@]+"${logs[@]}"}' EXIT
run_tests() {
  local label=$1 log start status
  shift
  log="$(mktemp)"
  logs+=("$log")
  echo "== swift test: $label"
  start=$SECONDS
  swift test ${flags[@]+"${flags[@]}"} --skip-build "$@" 2>&1 | tee "$log"
  status=${PIPESTATUS[0]}
  echo "== swift test: $label took $((SECONDS - start)) s"
  if (( status != 0 )); then
    python3 scripts/test-died "$log" || fail "swift test ($label) process died (exit $status) with the tests above unfinished"
    fail "swift test ($label) exited $status"
  fi
}

# The perf and timing tests run in CI's Perf step, never here. An empty
# regex would skip every test, so the flag goes in only when there is one.
perf=$(python3 scripts/test-scope perf) || fail "Tests/perf-suites.txt: fix the line above"
skip_perf=()
[[ -z "$perf" ]] || skip_perf=(--skip "$perf")

# run_all: every test but the perf ones.
run_all() {
  if [[ "$(uname)" == Darwin ]]; then
    # AppSnapshotTests renders images. Run in parallel with every other target,
    # the whole step was killed mid-run with no output (dev runs 38734211999,
    # 38746333198, 38759641683), most likely by the runner running out of
    # memory; ci.yml samples memory to confirm it. So it runs on its own, one
    # test at a time (--no-parallel serializes Swift Testing), and the rest stay
    # parallel. Each run prints its wall time.
    run_tests "all but AppSnapshotTests" --skip "^AppSnapshotTests\.${perf:+|$perf}"
    run_tests "AppSnapshotTests, one at a time" --filter '^AppSnapshotTests\.' ${skip_perf[@]+"${skip_perf[@]}"} --no-parallel
  else
    run_tests "all" ${skip_perf[@]+"${skip_perf[@]}"}
  fi
}

if (( ! changed_mode )); then
  run_all
else
  echo "== changed since $base (merge base ${fork:0:12}):"
  printf '%s\n' "${changed:-(nothing)}" | sed 's/^/  /'
  scope_args=()
  [[ "$(uname)" == Darwin ]] || scope_args=(--linux)
  scope=$(printf '%s\n' "$changed" | python3 scripts/test-scope changed ${scope_args[@]+"${scope_args[@]}"}) \
    || fail "test-scope: could not map the changed paths"
  if [[ "$scope" == all ]]; then
    echo "== a change can reach every test (Package.swift, Package.resolved or a new Sources/ folder): all of them"
    run_all
  else
    tests=$(sed -n 1p <<<"$scope") snaps=$(sed -n 2p <<<"$scope")
    [[ -z "$tests" ]] || run_tests "changed: $tests" --filter "$tests" ${skip_perf[@]+"${skip_perf[@]}"}
    [[ -z "$snaps" ]] || run_tests "changed snapshots, one at a time: $snaps" --filter "$snaps" ${skip_perf[@]+"${skip_perf[@]}"} --no-parallel
    [[ -n "$tests$snaps" ]] || echo "== swift test: no test target covers the changed files; the build above is the check"
  fi
fi

echo
for log in ${logs[@]+"${logs[@]}"}; do grep -E "Test run with [0-9]+ tests?" "$log" | tail -1; done
(( ! changed_mode )) || echo "Scoped to the changes since $base; plain scripts/ci is the full gate."
echo "CI: PASS"
