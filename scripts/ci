#!/usr/bin/env bash
# scripts/ci: the one gate. Runs the no-crash lint, the app-state rule, the
# duplicate-code check, swift build and swift test, then prints PASS or FAIL
# and exits with the real status. CI runs exactly this on Linux and macOS; run
# it before every PR. On Linux, Package.swift declares only the Model targets,
# so build and test cover those; on macOS they cover everything.
#
# The no-crash lint fails on crash-prone constructs in Sources/ (tests exempt):
#   try!  as!  fatalError(  preconditionFailure(  precondition(  unowned  .first!  .last!
#
# The app-state rule keeps views dumb: files under Sources/*App/ may read their
# Model and call its methods, never write its state. Each App names its Model
# value `model`, and the rule fails on any line there that
#   - assigns through it:        model.x = ...   model.x += ...   model = ...
#   - binds to it:               $model   $model.x
#   - mutates a collection in it: model.items.append(...) / insert / remove... / toggle / sort
# (the `@State private var model = ...` declaration is allowed). The Model
# targets also keep stored state `private(set)`, so the compiler backs this up.
#
# The design lint enforces docs/design.md "Component order": system components
# first, then SuiteUI, never a hand-rolled look-alike. Comment lines are skipped.
#   apps (Sources/*App/) fail on
#     raw color      Color(red: / hue: / white:  Color(.sRGB / .displayP3  Color(#  #colorLiteral  NSColor(  UIColor(
#     custom font    .font(.custom(  Font.custom(  .system(size: <number>
#     literal size   cornerRadius: <number>  .cornerRadius(<number>)  .padding([edges,] <number>)
#                    .frame(...: <number>)  ...ColumnWidth(<number>)
#     hand-made glass  .blur(radius:  NSVisualEffectView  any Material
#     look-alike     a struct named *Button, *Slider, *Toggle, *Picker, *Stepper, *Sidebar
#     inspector switch  in an inspector file (named *Inspector*, or using an
#                    Inspector...Row), more Toggle( than .toggleStyle(.checkbox):
#                    inspectors use checkboxes, never switches (Pro density)
#   SuiteUI fails on the raw color, custom font and literal size rules outside
#   Tokens.swift, and on .blur(radius: / .background(.ultraThin /
#   NSVisualEffectView outside Glass.swift. Before scanning, the step runs a
#   self-test: fixture lines it must catch and token lines it must let pass.
#
# The duplicate check runs jscpd (pinned) over Sources/ and fails when duplicated
# lines exceed JSCPD_THRESHOLD percent. It starts at creative-core's threshold
# and only ever goes down: lower it when you remove a clone, never raise it.
# Without npx, or when npm can't fetch jscpd, the check prints SKIP and the gate
# goes on; CI enforces it.
#
# On a Mac with only the Command Line Tools (no Xcode), Swift Testing lives in
# a framework directory swift does not search by default, so we add it.
# bash 3.2 compatible (macOS /bin/bash).
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

fail() { echo; echo "CI: FAIL ($1)"; exit 1; }

echo "== no-crash lint (Sources/)"
pattern='try!|as!|fatalError\(|preconditionFailure\(|precondition\(|unowned |\.first!|\.last!'
if grep -rnE "$pattern" Sources/; then
  fail "no-crash lint: replace the lines above with throwing code"
fi
echo "ok"

echo "== app-state rule (Sources/*App/)"
id='[A-Za-z_][A-Za-z0-9_]*'
writes="(^|[^A-Za-z0-9_.\$])(self\.)?model(\.$id)*[[:space:]]*[-+*/%]?=([^=]|\$)"
binds='\$model([^A-Za-z0-9_]|$)'
mutators="(^|[^A-Za-z0-9_.])(self\.)?model(\.$id)+\.(append|insert|remove$id|removeAll|toggle|sort|reverse)\("
if hits=$(grep -rnE "$writes|$binds|$mutators" Sources/*App/ 2>/dev/null \
    | grep -vE "(var|let)[[:space:]]+model[[:space:]]*(:|=)"); then
  echo "$hits"
  fail "app-state rule: views must change state through their Model's methods; add one there"
fi
echo "ok"

echo "== design lint (Sources/*App/, Sources/SuiteUI/)"
raw_color='Color\((red|hue|white):|Color\(\.(sRGB|displayP3)|Color\(#|#colorLiteral|(NS|UI)Color\('
custom_font='\.font\(\.custom\(|Font\.custom\(|(\.font\(\.|Font\.)system\(size:[[:space:]]*[0-9]'
literal_size='cornerRadius[:(][[:space:]]*[0-9]|\.padding\(([^)]*,)?[[:space:]]*[0-9]|\.frame\([^)]*:[[:space:]]*[0-9]|ColumnWidth\(([^)]*[:,])?[[:space:]]*[0-9]'
handmade_glass='\.blur\(radius:|\.background\(\.ultraThin|NSVisualEffectView'
lookalike='struct[[:space:]]+[A-Za-z0-9_]*(Button|Slider|Toggle|Picker|Stepper|Sidebar)([^A-Za-z0-9_]|$)'
toggle='(^|[^A-Za-z0-9_])Toggle\('
checkbox='\.toggleStyle\(\.checkbox\)'
# hits RULE REGEX DIR [grep args]: "path:line: content (RULE)" per non-comment hit.
hits() {
  grep -rnHE --include='*.swift' "${@:4}" -e "$2" "$3" 2>/dev/null \
    | grep -vE '^[^:]*:[0-9]+:[[:space:]]*(//|/?\*)' | sed "s/\$/  ($1)/"
}
# inspector_switches APP: every Toggle( in APP's inspector files (named
# *Inspector*, or using an Inspector...Row) whose file has more Toggles than
# .toggleStyle(.checkbox). Counting per file catches a style on the next line.
inspector_switches() {
  local f code
  { find "$1" -name '*Inspector*.swift'; grep -rlE --include='*.swift' 'Inspector[A-Za-z]*Row' "$1"; } 2>/dev/null \
    | sort -u | while IFS= read -r f; do
      code=$(grep -vE '^[[:space:]]*(//|/?\*)' "$f")
      if (( $(grep -cE "$toggle" <<<"$code") > $(grep -cE "$checkbox" <<<"$code") )); then
        hits "switch in an inspector: add .toggleStyle(.checkbox)" "$toggle" "$f"
      fi
    done
}
# design_lint ROOT: every design-rule hit under ROOT/Sources; nothing when clean.
design_lint() {
  local app s="$1/Sources"
  for app in "$s"/*App; do
    hits "raw color: use SuiteColor" "$raw_color" "$app"
    hits "custom font: use SuiteFont or a system text style" "$custom_font" "$app"
    hits "literal size: use SuiteSpacing, SuiteRadius or SuiteSize" "$literal_size" "$app"
    hits "hand-made glass: use SuiteUI's GlassPanel or ToolbarGroup" "$handmade_glass|Material" "$app"
    hits "look-alike control: use the system control" "$lookalike" "$app"
    inspector_switches "$app"
  done
  hits "raw value outside Tokens.swift" "$raw_color|$custom_font|$literal_size" "$s/SuiteUI" --exclude=Tokens.swift
  hits "glass outside Glass.swift" "$handmade_glass" "$s/SuiteUI" --exclude=Glass.swift
}
# Self-test: each "dir/file|line" fixture alone in a scratch tree.
must_catch=(
  'XApp/V.swift|.foregroundStyle(Color(red: 1, green: 0.5, blue: 0))'
  'XApp/V.swift|Color(hue: 0.5, saturation: 1, brightness: 1)'
  'XApp/V.swift|.fill(Color(white: 0.2))'
  'XApp/V.swift|Color(.sRGB, red: 1, green: 1, blue: 1)'
  'XApp/V.swift|Color(#colorLiteral(red: 1, green: 0, blue: 0, alpha: 1))'
  'XApp/V.swift|Color(nsColor: NSColor(calibratedRed: 1, green: 0, blue: 0, alpha: 1))'
  'XApp/V.swift|let c = UIColor(red: 1, green: 0, blue: 0, alpha: 1)'
  'XApp/V.swift|.font(.custom("Avenir", size: 13))'
  'XApp/V.swift|Text("x").font(Font.custom("Avenir", size: 13))'
  'XApp/V.swift|.font(.system(size: 13, weight: .bold))'
  'XApp/V.swift|.cornerRadius(8)'
  'XApp/V.swift|.background(.red, in: RoundedRectangle(cornerRadius: 12))'
  'XApp/V.swift|.clipShape(.rect(cornerRadius: 6))'
  'XApp/V.swift|.padding(8)'
  'XApp/V.swift|.padding(.horizontal, 10)'
  'XApp/V.swift|.frame(width: 32, height: 32)'
  'XApp/V.swift|.frame(maxWidth: .infinity, minHeight: 300)'
  'XApp/V.swift|.inspectorColumnWidth(min: 220, ideal: 260)'
  'XApp/V.swift|.blur(radius: 20)'
  'XApp/V.swift|.background(.ultraThinMaterial)'
  'XApp/V.swift|.background(.regularMaterial, in: Capsule())'
  'XApp/V.swift|struct PlayButton: View {'
  'XApp/V.swift|private struct LayerSidebar<Row: View>: View {'
  'XApp/V.swift|struct OpacityStepper: View {'
  'XApp/LayerInspector.swift|Toggle("Enabled", isOn: on).toggleStyle(.switch)'
  'XApp/LayerInspector.swift|Toggle("Enabled", isOn: on)'
  'XApp/V.swift|InspectorRow("") { Toggle("Locked", isOn: on) }'
  'SuiteUI/Panel.swift|.frame(width: 32, height: 32)'
  'SuiteUI/Panel.swift|.fill(Color(red: 1, green: 0, blue: 0))'
  'SuiteUI/Panel.swift|.background(.ultraThinMaterial)'
)
must_pass=(
  'XApp/V.swift|.padding(SuiteSpacing.m)'
  'XApp/V.swift|.padding(.horizontal, SuiteSpacing.l)'
  'XApp/V.swift|.padding(SuiteSpacing.xxl * 2)'
  'XApp/V.swift|.background(SuiteColor.surface, in: RoundedRectangle(cornerRadius: SuiteRadius.medium))'
  'XApp/V.swift|.frame(maxWidth: .infinity, alignment: .leading)'
  'XApp/V.swift|.font(.system(.body, design: .monospaced))'
  'XApp/V.swift|Color(nsColor: .separatorColor)'
  'XApp/V.swift|struct ButtonBarHost: View {'
  'XApp/LayerInspector.swift|Toggle("Enabled", isOn: on).toggleStyle(.checkbox)'
  'XApp/LayerInspector.swift|SidebarToggle(id: "v", title: "Visible", onSymbol: "eye", offSymbol: "eye", isOn: on)'
  'XApp/V.swift|Toggle("Hidden", isOn: on)'
  'XApp/V.swift|// Never write Color(red: 1, green: 0, blue: 0) or .ultraThinMaterial here.'
  'SuiteUI/Tokens.swift|public static let artboard = Color(red: 1, green: 1, blue: 1)'
  'SuiteUI/Glass.swift|content.background(.ultraThinMaterial, in: shape)'
)
missed=$(
  t="$(mktemp -d)"
  trap 'rm -rf "$t"' EXIT
  fixture() {
    rm -rf "$t/Sources" && mkdir -p "$t/Sources/${1%%/*}" && printf '%s\n' "${1#*|}" >"$t/Sources/${1%%|*}"
    design_lint "$t"
  }
  for f in "${must_catch[@]}"; do [[ -n "$(fixture "$f")" ]] || echo "not caught: $f"; done
  for f in "${must_pass[@]}"; do got=$(fixture "$f"); [[ -z "$got" ]] || echo "false hit: $got"; done
)
[[ -z "$missed" ]] || { echo "$missed"; fail "design lint self-test: fix the patterns in scripts/ci"; }
found=$(design_lint .)
if [[ -n "$found" ]]; then
  echo "$found"
  fail "design lint: use the system component or a SuiteUI token (docs/design.md, Component order)"
fi
echo "ok"

echo "== duplicate code (jscpd, Sources/)"
JSCPD_VERSION=5.3.2
JSCPD_THRESHOLD=0.8
if ! command -v npx >/dev/null 2>&1; then
  echo "SKIP (npx not found; install Node 18+ to run this check)"
elif ! npx --yes "jscpd@$JSCPD_VERSION" --version >/dev/null 2>&1; then
  echo "SKIP (npx could not fetch jscpd@$JSCPD_VERSION from the npm registry)"
else
  JSCPD_NO_TIPS=1 npx --yes "jscpd@$JSCPD_VERSION" --format swift --reporters console \
    --threshold "$JSCPD_THRESHOLD" Sources/ \
    || fail "jscpd: duplicated lines over $JSCPD_THRESHOLD%; move the shared code into SuiteUI or a Model instead of copying it"
fi

flags=()
if [[ "$(uname)" == Darwin ]]; then
  clt=/Library/Developer/CommandLineTools/Library/Developer
  if [[ "$(xcode-select -p 2>/dev/null)" == /Library/Developer/CommandLineTools* && -d "$clt/Frameworks/Testing.framework" ]]; then
    flags=(-Xswiftc -F -Xswiftc "$clt/Frameworks" -Xlinker -F -Xlinker "$clt/Frameworks"
           -Xlinker -rpath -Xlinker "$clt/Frameworks" -Xlinker -rpath -Xlinker "$clt/usr/lib")
  fi
fi

echo "== swift build"
swift build ${flags[@]+"${flags[@]}"} || fail "swift build"

echo "== swift test"
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
swift test ${flags[@]+"${flags[@]}"} 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
(( status == 0 )) || fail "swift test exited $status"

echo
grep -E "Test run with [0-9]+ tests?" "$log" | tail -1
echo "CI: PASS"
