#!/usr/bin/env python3
# scripts/realperf-watch: the outside-the-app half of the real-app perf
# journeys (UITests/Journey+Health.swift). macOS runs every UI test runner in
# an app sandbox, so the runner can't start /usr/bin/sample or ps, or write
# outside its container; `scripts/ui-test perf` starts this next to
# xcodebuild instead. A journey drops `<id>.req` (the app's pid) in its
# container's tmp/realperf/ right before a gesture and waits for this to take
# it; this samples that pid for 3 s (`sample <pid> 3`) while the gesture runs
# and judges the report with scripts/sample-surfaces. When the journey drops
# `<id>.done` (the gesture is over), this waits 3 s and reads the pid's CPU
# twice over one second from `ps -o time=` (CPU seconds used, so no decaying
# average), then writes OUT/<id>.json (the runner may read anything) with
# the surface verdict and the two CPU readings, and keeps OUT/<id>.sample.txt.
# It never signals or quits a process. It runs until --parent exits.
# `--photo PATH` instead writes the 8K test photo Photo's journey opens
# (7680 x 4320, a blue-to-orange sky gradient, as writeTestPhoto draws it):
# the sandboxed runner can only write inside its own container, and a file
# there is another app's data to Photo. Stdlib Python 3 only.
#
# Usage: scripts/realperf-watch OUT --parent PID [--containers GLOB]
#        scripts/realperf-watch --photo PATH
import glob
import json
import os
import subprocess
import sys
import struct
import time
import zlib

HERE = os.path.dirname(os.path.abspath(__file__))
CONTAINERS = os.path.expanduser("~/Library/Containers/*JourneyTests.xctrunner/Data/tmp/realperf")
SAMPLE_SECONDS, IDLE_WAIT, DONE_TIMEOUT = 3, 3.0, 180.0


def cpu_seconds(pid):
    """CPU seconds pid has used: ps prints [[hh:]mm:]ss.cc; None when it can't."""
    out = subprocess.run(["/bin/ps", "-o", "time=", "-p", str(pid)], capture_output=True, text=True)
    total = 0.0
    try:
        for field in out.stdout.strip().split(":"):
            total = total * 60 + float(field)
    except ValueError:
        return None
    return total if out.returncode == 0 else None


def cpu_percent(pid):
    """The pid's CPU over the next second, in percent of one core."""
    first, started = cpu_seconds(pid), time.monotonic()
    time.sleep(1)
    second = cpu_seconds(pid)
    if first is None or second is None:
        return None
    return 100 * (second - first) / (time.monotonic() - started)


def handle(request, out):
    """Samples the request's pid, waits for its .done, measures idle CPU, writes OUT/<id>.json."""
    folder, name = os.path.split(request)
    rid = name[:-4]
    with open(request) as handle_:
        pid = int(handle_.read().split()[0])
    os.remove(request)  # the journey starts its gesture once the request is gone
    sample_file = os.path.join(out, rid + ".sample.txt")
    sampled = subprocess.run(["/usr/bin/sample", str(pid), str(SAMPLE_SECONDS), "-file", sample_file],
                             capture_output=True, text=True)
    result = {"pid": pid, "sample_status": sampled.returncode, "sample_file": sample_file}
    if sampled.returncode == 0:
        verdict = subprocess.run([sys.executable, os.path.join(HERE, "sample-surfaces"), sample_file],
                                 capture_output=True, text=True)
        result.update(surface_status=verdict.returncode, surface=verdict.stdout.strip())
    else:
        result.update(surface_status=2, surface="sample failed: " + (sampled.stderr or sampled.stdout).strip()[:300])
    done = os.path.join(folder, rid + ".done")
    deadline = time.monotonic() + DONE_TIMEOUT
    while not os.path.exists(done) and time.monotonic() < deadline:
        time.sleep(0.1)
    if os.path.exists(done):
        os.remove(done)
        time.sleep(IDLE_WAIT)
        result["idle"] = [cpu_percent(pid), cpu_percent(pid)]
    else:
        result["idle"] = []
        result["idle_note"] = "the journey never said the gesture was done"
    temp = os.path.join(out, rid + ".json.part")
    with open(temp, "w") as handle_:
        json.dump(result, handle_)
    os.replace(temp, os.path.join(out, rid + ".json"))
    print(f"realperf-watch: {rid} pid {pid}: {result.get('surface', '').splitlines()[0] if result.get('surface') else ''}"
          f" idle {result['idle']}", flush=True)


def write_photo(path, width=7680, height=4320):
    """An RGB PNG: each row one color, from (0.16, 0.42, 0.86) at the top to (0.98, 0.62, 0.42)."""
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
    top, bottom = (0.16, 0.42, 0.86), (0.98, 0.62, 0.42)
    rows = bytearray()
    for y in range(height):
        t = y / (height - 1)
        rgb = bytes(round(255 * (a + (b - a) * t)) for a, b in zip(top, bottom))
        rows += b"\x00" + rgb * width
    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    with open(path, "wb") as handle_:
        handle_.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(bytes(rows), 6))
                      + chunk(b"IEND", b""))


def main(argv):
    args = argv[1:]
    if len(args) == 2 and args[0] == "--photo":
        write_photo(args[1])
        return 0
    if len(args) < 3 or args[1] != "--parent":
        print("usage: scripts/realperf-watch OUT --parent PID [--containers GLOB]", file=sys.stderr)
        return 2
    out, parent = os.path.abspath(args[0]), int(args[2])
    pattern = args[4] if len(args) > 4 and args[3] == "--containers" else CONTAINERS
    os.makedirs(out, exist_ok=True)
    while True:
        try:
            os.kill(parent, 0)
        except OSError:
            return 0
        for request in sorted(glob.glob(os.path.join(pattern, "*.req"))):
            try:
                handle(request, out)
            except (OSError, ValueError) as error:
                print(f"realperf-watch: {request}: {error}", flush=True)
        time.sleep(0.1)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
