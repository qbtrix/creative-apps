#!/usr/bin/env python3
# scripts/check-body-counts: budget tests count the window under test, never the
# whole test process (factory lesson 345). Suites running alongside open their own
# windows in the same process, so a process-wide static counter read by a test
# comes out wrong on CI (dev-red #5938, #5952, #5962, #5969).
#
# Three hits, each a `path::Type.member` line:
#   - a stored body counter anywhere in Sources/ or Tests/: `static var bodyRuns = 0`
#     or `bodyRuns += 1`. A view counts through SuiteUI's BodyTally instead: it
#     conforms to BodyCounted (which gives it `bodyRuns`) and runs
#     `let _ = bodyTally.ran(Self.self)` in its body.
#   - a test that reads `X.bodyRuns` outside `extension BodyCountSuites`: only that
#     suite's trait gives a test its window under test, so elsewhere the read is
#     the process's count.
#   - a test that reads a stored static Int counter declared in Sources/
#     (`static var lifts = 0` on CanvasRenderer, read as `CanvasRenderer.lifts`):
#     count on the object under test instead.
# Tests/body-counts-baseline.txt lists today's hits (grandfathered):
#   scripts/check-body-counts                    fail on a hit the baseline doesn't list,
#                                                and on a listed one that is gone (prune it)
#   scripts/check-body-counts --update-baseline  rewrite it; refuses to add a line unless
#                                                --allow-increase (it only shrinks)
# --root DIR runs against another tree (the tests). Exit 0 clean, 1 on a hit.
# Python 3 stdlib only.
import argparse
import pathlib
import re
import sys

HERE = pathlib.Path(__file__).resolve().parent.parent
LEX = re.compile(r'"""[\s\S]*?"""|"(?:\\.|[^"\\\n])*"|//[^\n]*|/\*[\s\S]*?\*/')
TYPE = re.compile(r"^(\s*)(?:[\w@()]+\s+)*(?:struct|class|enum|actor|extension)\s+([A-Za-z_]\w*)")
STORED_BODY = re.compile(r"\bstatic\s+var\s+bodyRuns\s*(?::\s*Int\s*)?=|\bbodyRuns\s*\+=")
COUNTER = re.compile(r"\bstatic\s+var\s+((?:[A-Za-z_]\w*\s*(?::\s*Int\s*)?=\s*\d+\s*,?\s*)+)$")
READ = re.compile(r"\b([A-Z]\w*)(?:<[^<>()]*>)?\.([a-z]\w*)\b")
BASELINE = "Tests/body-counts-baseline.txt"
HEADER = """# Tests/body-counts-baseline.txt: process-wide counts a test still reads, grandfathered
# (factory lesson 345). Written by scripts/check-body-counts --update-baseline, never by
# hand. It only shrinks: count on the window or object under test (SuiteUI's BodyTally)
# and drop the line in the same PR. Line: `path::Type.member`.
"""


def blank(text):
    """Comments and string contents become spaces; newlines are kept."""
    keep = lambda s: re.sub(r"[^\n]", " ", s)
    def sub(m):
        t = m.group()
        if t.startswith("/"):
            return keep(t)
        q = 3 if t.startswith('"""') else 1
        return t[:q] + keep(t[q:-q]) + t[-q:]
    return LEX.sub(sub, text)


def owner(lines, i):
    """The innermost type declared above line i at a shallower indent."""
    indent = len(lines[i]) - len(lines[i].lstrip())
    for j in range(i - 1, -1, -1):
        m = TYPE.match(lines[j])
        if m and len(m.group(1)) < indent:
            return m.group(2)
    return "?"


def swift(root, top):
    return {f.relative_to(root).as_posix(): blank(f.read_text(errors="replace"))
            for f in sorted((root / top).rglob("*.swift"))}


def scan(root):
    sources, tests = swift(root, "Sources"), swift(root, "Tests")
    hits, counters = set(), set()
    for rel, code in {**sources, **tests}.items():
        lines = code.splitlines()
        for i, line in enumerate(lines):
            if STORED_BODY.search(line):
                hits.add(f"{rel}::{owner(lines, i)}.bodyRuns")
            m = COUNTER.search(line.strip()) if rel.startswith("Sources/") else None
            if m and "bodyRuns" not in line:
                for name in re.findall(r"([A-Za-z_]\w*)\s*(?::\s*Int\s*)?=", m.group(1)):
                    counters.add((owner(lines, i), name))
    for rel, code in tests.items():
        scoped = "extension BodyCountSuites" in code or rel.endswith("/BodyCountSuites.swift")
        for m in READ.finditer(code):
            kind, member = m.group(1), m.group(2)
            if (kind, member) in counters or (member == "bodyRuns" and not scoped):
                hits.add(f"{rel}::{kind}.{member}")
    return hits


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=str(HERE))
    ap.add_argument("--update-baseline", action="store_true")
    ap.add_argument("--allow-increase", action="store_true")
    a = ap.parse_args()
    root = pathlib.Path(a.root)
    path = root / BASELINE
    listed = set()
    if path.exists():
        listed = {l.strip() for l in path.read_text().splitlines() if l.strip() and not l.startswith("#")}
    hits = scan(root)
    if a.update_baseline:
        new = hits - listed
        if new and not a.allow_increase:
            print("check-body-counts: refusing to grow the baseline (--allow-increase):", file=sys.stderr)
            for h in sorted(new):
                print(f"  {h}", file=sys.stderr)
            return 1
        path.write_text(HEADER + "".join(f"{h}\n" for h in sorted(hits)))
        print(f"check-body-counts: wrote {len(hits)} lines to {BASELINE}")
        return 0
    bad = 0
    for h in sorted(hits - listed):
        print(f"{h}: a process-wide count in a test; count the window under test through BodyTally (lesson 345)")
        bad = 1
    for h in sorted(listed - hits):
        print(f"{h}: listed in {BASELINE} but no longer hits; drop the line")
        bad = 1
    if not bad:
        print(f"check-body-counts: clean ({len(hits)} grandfathered in {BASELINE})")
    return bad


if __name__ == "__main__":
    sys.exit(main())
