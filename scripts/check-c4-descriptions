#!/usr/bin/env python3
# scripts/check-c4-descriptions BASE: fails when the branch rewrites the
# top-level "description" of a C4 part that already exists at BASE (the merge
# base; scripts/ci --changed passes it). Why: each part's description is one
# JSON string, so two PRs that both append a sentence to it always conflict,
# and scripts/merge-json can't merge two edits to one value. A new file in a
# target is already owned through the part's `paths`, so a feature PR has no
# reason to touch the prose.
#
# Allowed: adding a part file (a new component brings its own description,
# and the PR may touch other descriptions with it); adding or changing any
# other key (`paths`, `relationships`, `order`); and a PR whose every changed
# path is under docs/c4/parts/ (a C4-only refresh of the prose, one at a time).
#
# The current side is the working tree plus untracked files, like
# scripts/ci --changed. Values are compared parsed, so reformatting never
# trips it. Stdlib Python 3 only. Exit 0: clean; 1: violations printed.
import json
import subprocess
import sys

PARTS = "docs/c4/parts/"


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def lines(s):
    return {l for l in s.splitlines() if l}


def main():
    if len(sys.argv) != 2:
        print("usage: scripts/check-c4-descriptions BASE", file=sys.stderr)
        return 2
    base = sys.argv[1]
    untracked = lines(git("ls-files", "--others", "--exclude-standard"))
    changed = lines(git("diff", "--name-only", base)) | untracked
    added = lines(git("diff", "--name-only", "--diff-filter=A", base)) | untracked
    if not any(p.startswith(PARTS) for p in changed):
        return 0
    if all(p.startswith(PARTS) for p in changed):
        return 0  # a C4-only PR may refresh the prose
    if any(p.startswith(PARTS) and p.endswith(".json") for p in added):
        return 0  # a new component part
    bad = []
    modified = lines(git("diff", "--name-only", "--diff-filter=M", base, "--", PARTS))
    for path in sorted(p for p in modified if p.endswith(".json")):
        try:
            old = json.loads(git("show", f"{base}:{path}")).get("description")
            with open(path, encoding="utf-8") as f:
                new = json.load(f).get("description")
        except (ValueError, OSError, AttributeError):
            continue  # unparsable parts fail in scripts/c4-assemble, with a better message
        if old is not None and new != old:
            bad.append(path)
    for path in bad:
        print(f"{path}: changes the existing description")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
