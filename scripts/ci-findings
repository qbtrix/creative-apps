#!/usr/bin/env bash
# scripts/ci-findings <ui-test-log>: journeys.yml's Findings step. One open
# issue per failing journey, filed as "CI finding: <Target/Class/test>" (the
# form UITests/quarantine.json takes), labelled `finding` and `line:<app>`,
# with a `Test: \`<name>\`` body line. Leads and audits relabel and retitle
# these, so a test's open issue is ANY open issue, under any label, whose title
# is that "CI finding:" title or whose body has that Test: line.
#  - The open issues come from one `gh issue list --state open` with no label
#    filter and a 5000 cap, not a search per test: the search index lags new
#    issues (a finding filed minutes ago would be missed and re-filed) and is
#    rate-limited, while a red run can fail dozens of tests. A list that comes
#    back at the cap may be truncated, so it counts as a failed list.
#  - A failed test with a `finding` issue (not also `gap`) of that title gets
#    the body rewritten, but the `Feature:`, `Slice:` and `Owner:` lines a
#    triage added are read from the current body first and appended to the new
#    one, so routing survives the next red run. If the body can't be read the
#    issue is left alone. Any other open issue for the test (a `gap`, one with
#    no `finding` label, or one matched only by its Test: line) gets a "Still
#    failing" comment instead: its owner owns that body. Only a test with no
#    open issue gets a new one.
#  - A test that passed in this log (a "Test Case ... passed" line, so it ran
#    and was not skipped or left out of a scoped run) and has an open issue
#    gets "Passes on run <url>" and is closed. A test that also failed in the
#    log (a retry) stays open. Only a run on `dev` closes: a pass on a fix
#    branch (a proof run) says nothing about dev, so branch runs still file
#    and update findings but never close one.
#  - If the issue list fails or hits the cap, nothing is filed: a short list
#    would file a duplicate for every red test it missed.
# Needs gh and jq on PATH and RUN_URL, GITHUB_REF_NAME and GITHUB_SHA in the
# env; Tests/ci_findings/test_ci_findings.sh runs it against a stub gh.
set -uo pipefail
log=${1:?usage: scripts/ci-findings <ui-test-log>}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# names <failed|passed>: "Module.Class test" -> "Module/Class/test", one per line
names() {
  sed -n "s/.*Test Case '-\[\([^]]*\)\]' $1.*/\1/p" "$log" | sort -u | while read -r mc test; do
    echo "${mc%%.*}/${mc#*.}/$test"
  done
}
failed=$(names failed)
passed=$(names passed)
# Every open issue, any label.
cap=5000
if ! open=$(gh issue list --state open --limit "$cap" --json number,title,body,labels) \
    || ! count=$(jq length <<<"$open") || (( count >= cap )); then
  echo "::warning::could not list every open issue; filing nothing this run"
  exit 0
fi
# jq: does this issue belong to test $name (its "CI finding:" title or its Test: line)?
of_test='(.title == "CI finding: \($name)") or any((.body // "") | split("\n")[]; rtrimstr("\r") == "Test: `\($name)`")'

while IFS=/ read -r mod cls test; do
  [[ -n "$mod" ]] || continue
  name="$mod/$cls/$test" title="CI finding: $mod/$cls/$test"
  err=$(grep -F -m1 "error: -[$mod.$cls $test] : " "$log" | sed 's/^.*error: -\[[^]]*\] : //' | cut -c1-300 || true)
  app=$(sed -E 's/JourneyTests$//' <<<"$mod" | tr '[:upper:]' '[:lower:]')
  [[ "$app" != suite ]] || app=suiteui
  {
    echo "The \`$name\` journey failed in CI. The macOS job is report-only until beta, so this issue is how the red reaches its line; nobody's merge waited on it."
    echo
    echo "Test: \`$name\`"
    echo "Error: ${err:-none printed; see the run log}"
    echo "Run: $RUN_URL"
    echo "Branch: $GITHUB_REF_NAME"
    echo "Commit: $GITHUB_SHA"
  } >"$tmp/finding.md"
  # A finding of this title is ours to rewrite; any other issue for the test only hears about it.
  n=$(jq -r --arg t "$title" '[.[] | select(.title == $t and ([.labels[]?.name] | index("finding") and (index("gap") | not)))][0].number // empty' <<<"$open")
  other=$(jq -r --arg name "$name" "[.[] | select($of_test)][0].number // empty" <<<"$open")
  if [[ -z "$n" && -n "$other" ]]; then
    gh issue comment "$other" --body "Still failing on run $RUN_URL (branch $GITHUB_REF_NAME, commit $GITHUB_SHA). Error: ${err:-none printed; see the run log}" >/dev/null \
      && echo "commented on #$other: $name" || echo "::warning::could not comment on #$other for $name"
  elif [[ -n "$n" ]]; then
    if old=$(gh issue view "$n" --json body -q .body); then
      keep=$(grep -E '^[[:space:]]*(Feature|Slice|Owner):' <<<"$old" || true)
      [[ -z "$keep" ]] || { echo; echo "$keep"; } >>"$tmp/finding.md"
      gh issue edit "$n" --body-file "$tmp/finding.md" >/dev/null && echo "updated #$n: $name" \
        || echo "::warning::could not update #$n for $name"
    else
      echo "::warning::could not read #$n, left its body alone: $name"
    fi
  else
    labels=finding
    case "$app" in flare|design|photo|library|halo|suiteui) labels+=",line:$app" ;; esac
    gh issue create --title "$title" --label "$labels" --body-file "$tmp/finding.md" \
      || echo "::warning::could not file a finding for $name"
  fi
done <<<"$failed"

# Close open issues (any label) whose test ran and passed in this log, on dev only.
[[ "$GITHUB_REF_NAME" == dev ]] && jq -r '[.[] | .number as $n
    | ((.title | select(startswith("CI finding: ")) | .[12:]),
       ((.body // "") | split("\n")[] | rtrimstr("\r") | capture("^Test: `(?<t>[^`]+)`$").t))
    | "\($n)\t\(.)"] | unique[]' <<<"$open" |
  while IFS=$'\t' read -r n name; do
    grep -qxF -- "$name" <<<"$passed" && ! grep -qxF -- "$name" <<<"$failed" || continue
    [[ " ${closed:-} " != *" $n "* ]] || continue
    closed="${closed:-} $n"
    gh issue comment "$n" --body "Passes on run $RUN_URL" >/dev/null \
      && gh issue close "$n" >/dev/null && echo "closed #$n: $name" \
      || echo "::warning::could not close #$n for $name"
  done
exit 0
