#!/usr/bin/env python3
# scripts/test-scope: which swift tests run where, in one place, so the gate
# (scripts/ci and its --changed mode), CI's scoped runs and the nightly perf
# run (perf-nightly) agree on every test. Stdlib Python 3 only.
#
#   scripts/test-scope app APP[,APP...]    those apps' tests (flare, design, photo, library, halo, suite, suiteui)
#   scripts/test-scope changed [--linux]   the tests for the changed paths on stdin
#   scripts/test-scope build-apps          the apps a macOS build of the changed code paths on stdin needs
#   scripts/test-scope perf [APP]          the perf and timing tests, all or APP's
#   scripts/test-scope perf-report LOG     a perf run's swift test log as a markdown report
#   scripts/test-scope heavy [FILTER]      the CPU-heavy correctness tests, all or those FILTER takes
#   scripts/test-scope timing              the tests that assert a wall-clock bound and aren't in the perf list
#
# app and changed print two lines (app with a comma list: the union, as the
# lane's batch macOS gate asks for): the regex for the tests outside
# AppSnapshotTests, then the one for AppSnapshotTests (they run one at a
# time). An empty line means none. changed prints `all` instead when a path
# can change any test (Package.swift, Package.resolved, a new Sources/ dir).
# A Model maps to its Model tests, an App to its snapshot suites, SuiteUI to
# SuiteUITests and its snapshot suites, SuiteModel to every Model's tests,
# SuiteKernel (the editor kernel every Model and SuiteUI link) to
# SuiteKernelTests plus every Model's tests; the afterglow CLI
# (Sources/AfterGlowCLI*) and the real jobs (Tests/RealJobs/) to
# AfterGlowCLITests, which every Model and SuiteKernel also map to, so an
# adopt PR runs its app's real jobs; docs, scripts, UITests and the
# like map to none. The suite and suiteui scopes include SuiteKernelTests.
# --linux drops SuiteUITests and AppSnapshotTests, which Linux doesn't build;
# SuiteKernelTests is Linux-safe and stays.
#
# perf prints one regex, empty when there is none. Tests/perf-suites.txt lists
# the perf and timing tests: the gate and scoped runs skip them, and
# perf-nightly runs exactly them, so each test runs in one place. perf-report prints
# what they measured and flags (a ::warning:: on stderr) each failed bound a
# test missed by more than FLAG times; it never fails on a number.
#
# timing prints one line per enabled test in Tests/ (TESTS_DIR) that asserts a
# wall-clock bound but isn't in the perf list, so CI would gate a number a busy
# runner can miss; Tests/test_scope fails unless it prints nothing. A test
# asserts one when an #expect or #require line in its body has an upper bound
# (a spaced `<` or `<=`) against a Duration literal (`.milliseconds(`, ...), or
# one with a timing name before it (median, p95, elapsed, percentile, took...)
# in a file that reads a clock (ContinuousClock, `measure(`). Line-based on
# purpose: a lower bound, a count budget (bodies, copies) or a bound named any
# other way passes. A `not-timing:` comment in the test's body exempts it.
#
# heavy prints one regex, empty when there is none. Tests/heavy-suites.txt
# (same format as the perf list) lists correctness tests that cost seconds of
# CPU each in a debug build. scripts/ci runs them in a pass of their own, so
# they never crowd the time-limited suites off the cores in the shared parallel
# pass. With FILTER (a --changed run's test regex) it keeps only the listed
# tests FILTER would run.
#
# build-apps reads code paths (the fast lane's BUILD_RE files) and prints the
# apps whose macOS build-only run covers them, comma-separated (photo,design),
# or `all`. It derives each path's app from path_units: a path whose tests are
# one app's Model tests or snapshot suites is that app's (the CLI's tests,
# which every Model maps to, are left out: Linux builds the CLI), and
# UITests/<X>JourneyTests*.swift is X's. Every other path (SuiteUI, the
# kernel, SuiteModel, the shell, the CLI, shared snapshot or journey files,
# Package.swift, project.yml, a target the table doesn't know) prints `all`,
# and so does empty input: when in doubt, build everything.
#
# Regexes match swift test's ids, Target.Suite/test() or Target.freeTest().
# Never pass an empty one to --filter or --skip: it matches every test.
# Tested by Tests/test_scope.
import os
import re
import sys

APPS = {"flare": "Flare", "design": "Design", "photo": "Photo", "library": "Library", "halo": "Halo"}
SCOPES = list(APPS) + ["suite", "suiteui"]
SNAP = "AppSnapshotTests"
# AppSnapshotTests suites per scope, by name (an app's RenderBudget<App>Tests
# included). Flare and SuiteUI add the
# suites and free tests whose names don't say so, and each app has its test
# in the AppSnapshotTests suite. A snapshot test that fits no app runs in
# full runs only.
SNAPSHOTS = {
    "flare": r"((RenderBudget)?Flare[A-Za-z]*|AutosaveTests|AutosaveRecoveryTests|PlaybackDriverTests|StagePathTests)/|AppSnapshotTests/flare\(",
    "design": r"(RenderBudget)?Design[A-Za-z]*/|AppSnapshotTests/design\(",
    "photo": r"(RenderBudget)?Photo[A-Za-z]*/|AppSnapshotTests/photo\(",
    "library": r"(RenderBudget)?Library[A-Za-z]*/|AppSnapshotTests/library\(",
    "halo": r"(RenderBudget)?Halo[A-Za-z]*/|AppSnapshotTests/halo\(",
    "suiteui": r"(Suite[A-Za-z]*|GoldenImageTests|SnapshotHostTests)/|(suite[A-Za-z]*|snapshotsDrawRealSlidersNotPlaceholders"
    r"|theCapsuleDrawsOnlyBehindTheCurrentItem|aDisabledBarCommandDrawsDimmerThanAnEnabledOne)\(|AppSnapshotTests/suiteGallery\(",
}
MAC_ONLY = {"SuiteUITests", SNAP}
CLI = ("AfterGlowCLITests", None)  # the CLI drives every Model and the kernel headless
ALL = [("all", None)]
FLAG = 3  # a perf test is flagged when it measured over FLAG times a bound it asserts
PERF_LIST = os.environ.get("PERF_SUITES") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "Tests", "perf-suites.txt")
HEAVY_LIST = os.environ.get("HEAVY_SUITES") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "Tests", "heavy-suites.txt")


def app_units(app):
    """(target, suite regex or None for the whole target) for a scope."""
    if app in APPS:
        return [(APPS[app] + "ModelTests", None), (SNAP, SNAPSHOTS[app])]
    if app == "suite":  # SuiteModel, SuiteKernel, AfterGlow and the afterglow CLI: no snapshots yet
        return [("SuiteModelTests", None), ("SuiteKernelTests", None), CLI]
    if app == "suiteui":  # SuiteUI links the kernel, so its scoped run tests it too
        return [("SuiteUITests", None), ("AppAuditTests", None), ("SuiteKernelTests", None), (SNAP, SNAPSHOTS["suiteui"])]
    sys.exit(f"test-scope: unknown app {app!r}; one of {', '.join(SCOPES)}")


def path_units(path):
    if path in ("Package.swift", "Package.resolved"):
        return ALL
    parts = path.split("/")
    if len(parts) < 3:
        return []
    root, top = parts[0], parts[1]
    if root == "Sources":
        if top == "SuiteModel":  # every Model links it
            return [("SuiteModelTests", None)] + [(x + "ModelTests", None) for x in APPS.values()]
        if top == "SuiteKernel":  # every Model links it too
            return [("SuiteKernelTests", None), CLI] + [(x + "ModelTests", None) for x in APPS.values()]
        if top in ("AfterGlowCLI", "AfterGlowCLICore"):
            return [CLI]
        if top in ("AfterGlowApp", "SuiteShell"):
            return app_units("suite")
        if top == "SuiteUI":
            return [("SuiteUITests", None), (SNAP, SNAPSHOTS["suiteui"])]
        for app, x in APPS.items():
            if top == x + "Model":
                return [(x + "ModelTests", None), CLI]
            if top == x + "App":
                return [(SNAP, SNAPSHOTS[app])]
        return ALL  # a target this table doesn't know yet
    if root == "Tests":
        if top == SNAP:
            name = parts[2].removeprefix("RenderBudget")
            app = next((a for a, x in APPS.items() if name.startswith(x)), None)
            return [(SNAP, SNAPSHOTS[app] if app else None)]
        if top.endswith("ModelTests") or top in ("SuiteUITests", "AppAuditTests", "SuiteKernelTests", "AfterGlowCLITests"):
            return [(top, None)]
        if top == "RealJobs":
            return [CLI]
    return []


def regexes(units, linux=False):
    """The two lines app and changed print."""
    if ("all", None) in units:
        return "all"
    tests = sorted({t for t, _ in units if t != SNAP and not (linux and t in MAC_ONLY)})
    snaps = [] if linux else [r for t, r in units if t == SNAP]
    first = "^(%s)\\." % "|".join(tests) if tests else ""
    if None in snaps:
        second = r"^AppSnapshotTests\."
    elif snaps:
        # BodyCountSuites/ is the serialized parent the body-counter suites nest in.
        second = r"^AppSnapshotTests\.(BodyCountSuites/)?(%s)" % "|".join(dict.fromkeys(snaps))
    else:
        second = ""
    return first + "\n" + second


def build_app(path):
    """The one app whose macOS build covers a code path, or "all"."""
    if path.startswith("UITests/"):
        name = path.rsplit("/", 1)[-1]
        return next((a for a, x in APPS.items() if name.startswith(x + "JourneyTests")), "all")
    apps = set()
    for target, suite in path_units(path):
        if (target, suite) == CLI:
            continue
        apps.add(next((a for a, x in APPS.items() if target == x + "ModelTests" or (target == SNAP and suite == SNAPSHOTS[a])), "all"))
    return apps.pop() if len(apps) == 1 else "all"


def build_apps(paths):
    apps = {build_app(p) for p in paths}
    return "all" if not apps or "all" in apps else ",".join(sorted(apps))


def perf_entries(path=PERF_LIST):
    """(app, id) per line of the perf (or heavy) list; # starts a comment."""
    entries = []
    with open(path) as f:
        for n, line in enumerate(f, 1):
            fields = line.split("#", 1)[0].split()
            if not fields:
                continue
            if len(fields) != 2 or fields[0] not in SCOPES or not re.fullmatch(r"\w+\.\w+(/\w+){0,2}", fields[1]):
                sys.exit(f"test-scope: {path}:{n}: want '<app> <Target>.<Suite>[/<test>]' (a nested suite: <Target>.<Parent>/<Suite>[/<test>]) or '<app> <Target>.<freeTest>', got {line.strip()!r}")
            entries.append((fields[0], fields[1]))
    return entries


def perf_regex(app=None):
    if app is not None and app not in SCOPES:
        sys.exit(f"test-scope: unknown app {app!r}; one of {', '.join(SCOPES)}")
    ids = [i.replace(".", r"\.") for a, i in perf_entries() if app in (None, a)]
    return "^(%s)(/|\\()" % "|".join(ids) if ids else ""


def heavy_regex(within=None):
    ids = [i for _, i in perf_entries(HEAVY_LIST) if within is None or re.search(within, i + "/")]
    return "^(%s)(/|\\()" % "|".join(i.replace(".", r"\.") for i in ids) if ids else ""


TESTS_DIR = os.environ.get("TESTS_DIR") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "Tests")
DECL = re.compile(r"\b(struct|enum|class|actor|extension)\s+(\w+)[^{]*\{")
TEST_FUNC = re.compile(r"\bfunc\s+(\w+)")
# timing's detector (header): an upper bound in an #expect or #require that is a Duration literal, or that
# has a timing name before it in a file that reads a clock.
UPPER = re.compile(r"#(expect|require)\(.*\s<=?\s")
DURATION = re.compile(r"\s<=?\s*[^,]*\.(milli|micro|nano)?seconds\(")
TIMED_NAME = re.compile(r"(?i)(elapsed|median|p50|p95|p99|percentile|latency|took)[^<]*\s<=?\s")
CLOCK = re.compile(r"ContinuousClock|SuspendingClock|DispatchTime\.now|CFAbsoluteTimeGetCurrent|\bmeasure\(")


def swift_code(line):
    """A line with its string literals emptied and its // comment cut, for brace counting and matching."""
    line = re.sub(r'#".*?"#', '""', line)  # a raw string, #"..."#
    return re.sub(r'"(?:\\.|[^"\\])*"', '""', line).split("//", 1)[0]


def swift_tests(path):
    """(suite path, test name, disabled, body lines) for each @Test func in a Swift file. Tracks braces line
    by line; a suite (struct, enum, extension) is disabled when its attributes are, and so is each test in it."""
    with open(path, errors="replace") as f:
        lines = f.read().splitlines()
    # attrs: the code since the last line ending in { or } outside brackets, so a multi-line
    # @Test(arguments: [...]) or @Suite(.disabled(...)) above a declaration counts as its attributes.
    depth, suites, attrs, test, out = 0, [], [], None, []  # suites: (name, depth, disabled)
    for raw in lines:
        code = swift_code(raw)
        if test is None:
            head = "\n".join(attrs + [code])
            disabled = any(d for _, _, d in suites) or ".disabled(" in head
            name, decl = TEST_FUNC.search(code), DECL.search(code)
            if name and "@Test" in head:
                test = ([n for n, _, _ in suites], name.group(1), disabled, [], depth)
            elif decl:
                suites.append((decl.group(2), depth, disabled))
        if test:
            test[3].append(raw)
        attrs = attrs + [code]
        if code.rstrip().endswith(("{", "}")) and sum(map("".join(attrs).count, "([")) == sum(map("".join(attrs).count, ")]")):
            attrs = []
        depth += code.count("{") - code.count("}")
        if test and depth <= test[4] and any("{" in swift_code(b) for b in test[3]):
            out.append(test[:4])
            test = None
        while suites and depth <= suites[-1][1]:
            suites.pop()
    return out


def timing_tests(root=TESTS_DIR):
    """(id, where, bound) for each enabled test in Tests/<Target>/ that asserts a wall-clock bound, unless
    a `not-timing:` comment in its body marks it a deliberate exception."""
    found = []
    for target in sorted(os.listdir(root)):
        for dirpath, _, files in sorted(os.walk(os.path.join(root, target))):
            for name in sorted(f for f in files if f.endswith(".swift")):
                path = os.path.join(dirpath, name)
                with open(path, errors="replace") as f:
                    clock = bool(CLOCK.search(f.read()))
                for suites, test, disabled, body in swift_tests(path):
                    if disabled or any("not-timing:" in b for b in body):
                        continue
                    for line in body:
                        code = swift_code(line)
                        if UPPER.search(code) and (DURATION.search(code) or (clock and TIMED_NAME.search(code))):
                            found.append((f"{target}.{'/'.join(suites + [test])}", name, line.strip()))
                            break
    return found


def unlisted_timing(root=TESTS_DIR):
    perf = perf_regex()
    return [t for t in timing_tests(root) if not (perf and re.search(perf, t[0] + "("))]


NUMBER = r"([-+]?[0-9]*\.?[0-9]+(?:[eE][-+]?[0-9]+)?)"
VALUE = re.compile("\u2192 " + NUMBER + r"(?: seconds)?$")
# How Swift Testing shows a failed `#expect(a <= b)`: older releases on the
# issue line, `(a → 0.012 seconds) <= (b → 0.005 seconds)`; newer ones on
# the ↳ lines below it, `a <= b → false` with a's and b's values indented
# two more spaces under it.
INLINE = re.compile("\u2192 " + NUMBER + r"(?: seconds)?\)\s*<=?\s*\([^\u2192]*\u2192 " + NUMBER + r"(?: seconds)?\)")
COMPARE = re.compile(r".+ <=? .+ \u2192 false$")
DETAIL = re.compile(r"^\u21b3( *)(.*)$")
EVENT = re.compile(r"^\S+ Test (\w[^ ]*\))(?: with \d+ test cases?)? (passed|failed|recorded an issue)")
NUMBERS = re.compile(r"(?i)p50|p95|median|budget")
NOISE = re.compile(r"^(\S+ (Test|Suite) |\[\d+/\d+\]|Building |Build complete|Compiling )")  # swift test's own lines


def perf_report(log):
    with open(log, errors="replace") as f:
        lines = f.read().splitlines()
    results, ratios, printed, summary = {}, {}, [], []  # one `Test run with` line per test target
    issue, compared = None, None  # the test whose issue the ↳ lines explain; (indent, values) of its comparison

    def measured(name, lhs, rhs):
        if rhs > 0:
            ratios[name] = max(ratios.get(name, 0), lhs / rhs)

    for line in lines:
        if "Test run with" in line:
            summary.append(line.strip())
        event, detail = EVENT.match(line), DETAIL.match(line)
        if event:
            name, what = event.groups()
            issue = compared = None
            if what == "recorded an issue":
                results[name], issue = "failed", name
                for lhs, rhs in INLINE.findall(line):
                    measured(name, float(lhs), float(rhs))
            else:
                results.setdefault(name, what)
        elif detail and issue:
            indent, text = len(detail.group(1)), detail.group(2)
            if COMPARE.match(text):
                compared = (indent, [])
            elif compared and indent == compared[0] + 2:
                value = VALUE.search(text)
                compared[1].append(float(value.group(1)) if value else None)
                if len(compared[1]) == 2:
                    if None not in compared[1]:
                        measured(issue, *compared[1])
                    compared = None
            elif "\u2192" not in text and NUMBERS.search(text):
                printed.append(text)
        elif NUMBERS.search(line) and not NOISE.match(line):
            printed.append(line.strip())
    out = ["### Perf and timing tests (report only)", ""]
    out.append(f"These never fail the run. A test is flagged when it measured over {FLAG}x a bound it asserts.")
    out += [""] + ([s + "  " for s in summary] or ["No `Test run with` line: the run died or timed out (see the step log)."]) + [""]
    if results:
        out += ["| Test | Result |", "|---|---|"]
        for name, result in results.items():
            ratio = ratios.get(name)
            if result != "failed":
                cell = result
            elif ratio is None:
                cell = "failed (no measured bound in its issue)"
            elif ratio > FLAG:
                cell = f"**flagged: {ratio:.1f}x its bound**"
                print(f"::warning title=Perf flag::{name} measured {ratio:.1f}x its bound (flagged over {FLAG}x)", file=sys.stderr)
            else:
                cell = f"over its bound, {ratio:.1f}x"
            out.append(f"| `{name}` | {cell} |")
    if not summary:
        print("::warning title=Perf::the perf run printed no result line; it died or timed out", file=sys.stderr)
    if printed:
        out += ["", "<details><summary>What the tests printed</summary>", "", "```"] + printed + ["```", "</details>"]
    print("\n".join(out))


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("", [])
    if cmd == "app" and len(args) == 1:
        print(regexes([u for a in args[0].split(",") for u in app_units(a)]))
    elif cmd == "changed" and args in ([], ["--linux"]):
        units = [u for p in sys.stdin.read().splitlines() if p for u in path_units(p)]
        print(regexes(units, linux=bool(args)))
    elif cmd == "build-apps" and not args:
        print(build_apps([p for p in sys.stdin.read().splitlines() if p]))
    elif cmd == "perf" and len(args) <= 1:
        print(perf_regex(args[0] if args else None))
    elif cmd == "heavy" and len(args) <= 1:
        print(heavy_regex(args[0] if args else None))
    elif cmd == "perf-report" and len(args) == 1:
        perf_report(args[0])
    elif cmd == "timing" and not args:
        for test, where, bound in unlisted_timing():
            print(f"{test}  ({where}: {bound})")
    else:
        sys.exit("usage: scripts/test-scope app APP[,APP...] | changed [--linux] | build-apps | perf [APP] | heavy [FILTER] | perf-report LOG | timing")


if __name__ == "__main__":
    main(sys.argv[1:])
