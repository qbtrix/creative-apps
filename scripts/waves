#!/usr/bin/env python3
# scripts/waves: every app's feature waves as data, their checks, and the
# waves.md each app's features folder shows. Stdlib Python 3 only (macOS ships
# it; on Ubuntu: apt-get install -y python3). It generalizes the Halo
# (waves.py) and Library (waves.json, check_waves.py) checks to every app.
#
# Data: one file per feature, docs/blueprints/<app>/features/<feature>.wave.json,
# next to its packet <feature>.md. A lead marking its feature built edits only
# its own file (status, feature_issue), so leads never conflict. Fields:
#   title          the feature's one-line name (the table's "feature" cell)
#   wave           its wave label: 1, "0a", "W2"; sorted by number, then suffix
#   order          optional integer, the row order inside a wave (then by id)
#   status         planned | building | built
#   feature_issue  "#777", or "file when ready" until it is filed
#   covers, waits_on   the table cells, as text
#   depends        optional feature ids it waits on: each must be in an earlier wave
#   owned          optional paths it owns; a path ending in / or + covers every
#                  path under or starting with it. Two features in one wave
#                  never own the same path. An owned Sources/ file needs exactly
#                  one owner in docs/blueprints/<app>/c4-planned.json when that exists;
#                  with "every_source_file_owned": true at its top, every planned
#                  Sources/ file also needs a feature that owns it (Library).
#   cells          optional {"column header": "text"} for an app's extra columns
#   anything else (notes, journeys, quality, ...) is kept for the blueprint's own
#   generators (library's gen_section8.py reads them) and ignored here.
#
# Prose: docs/blueprints/<app>/waves.in.md, hand-written blueprint prose with
# one marker line naming the table's columns, for example
#   <!-- waves-table: wave | feature | packet | covers | waits on | feature issue | status -->
# The marker becomes the table. Known columns read the fields above ("feature"
# is title, "packet" is `<id>.md` or "no packet yet"); any other column reads cells.
# docs/blueprints/<app>/features/waves.md is generated: on dev the generated
# workflow (.github/workflows/generated.yml) prints and commits it, and PRs never
# edit it (the lane's PROTECTED list). Edit the data file or waves.in.md instead.
#
#   scripts/waves check [APP...]          the data checks; prints one line per problem
#   scripts/waves render [APP...]         write each app's features/waves.md
#   scripts/waves render --check [APP...] exit 1 if a committed waves.md differs
#   scripts/waves render --dry-run [APP...]  check and print, writing nothing (scripts/ci)
#   --root DIR                            the repo root (default: this script's parent)
# With no APP, every docs/blueprints/<app>/ that has a waves.in.md.
import json, os, re, sys

KNOWN = {"wave": "wave", "feature": "title", "covers": "covers", "waits on": "waits_on",
         "feature issue": "feature_issue", "status": "status"}
STATUSES = ("planned", "building", "built")
MARKER = re.compile(r"^<!-- waves-table: (.+?) -->$")
NOTICE = ("<!-- Generated by scripts/waves from docs/blueprints/{app}/waves.in.md and\n"
          "     docs/blueprints/{app}/features/*.wave.json. Edit those, never this file. -->\n")

def wave_key(w):
    m = re.match(r"\D*(\d+)(.*)", str(w))
    return (int(m.group(1)), m.group(2)) if m else (10**9, str(w))

def load_features(app_dir, problems):
    folder = os.path.join(app_dir, "features")
    out = []
    for fn in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
        if not fn.endswith(".wave.json"):
            continue
        path = os.path.join(folder, fn)
        try:
            f = json.load(open(path, encoding="utf-8"))
        except ValueError as e:
            problems.append(f"{path}: not valid JSON ({e})")
            continue
        if not isinstance(f, dict):
            problems.append(f"{path}: not a JSON object")
            continue
        f["id"] = fn[: -len(".wave.json")]
        f["_path"] = path
        f["_packet"] = os.path.isfile(os.path.join(folder, f["id"] + ".md"))
        out.append(f)
    return sorted(out, key=lambda f: (wave_key(f.get("wave")), f.get("order", 0) if isinstance(f.get("order"), int) else 0, f["id"]))

def covers(a, b):
    return a == b or (a.endswith(("/", "+")) and b.startswith(a))

def check(app_dir, features):
    problems = []
    byid = {f["id"]: f for f in features}
    for f in features:
        p = f["_path"]
        for k in ("title", "covers", "waits_on", "feature_issue"):
            if not isinstance(f.get(k), str) or not f[k]:
                problems.append(f"{p}: needs a text \"{k}\"")
        if not isinstance(f.get("wave"), (int, str)) or isinstance(f.get("wave"), bool):
            problems.append(f"{p}: needs a \"wave\" (a number or a label like \"0a\")")
        if f.get("status") not in STATUSES:
            problems.append(f"{p}: \"status\" must be one of {', '.join(STATUSES)}")
        if "order" in f and (not isinstance(f["order"], int) or isinstance(f["order"], bool)):
            problems.append(f"{p}: \"order\" must be an integer")
        for k in ("depends", "owned"):
            if k in f and not (isinstance(f[k], list) and all(isinstance(x, str) for x in f[k])):
                problems.append(f"{p}: \"{k}\" must be a list of text")
        if "cells" in f and not (isinstance(f["cells"], dict) and all(isinstance(v, str) for v in f["cells"].values())):
            problems.append(f"{p}: \"cells\" must map column headers to text")
    if problems:
        return problems
    for f in features:
        for dep in f.get("depends", []):
            if dep not in byid:
                problems.append(f"{f['id']} depends on unknown feature {dep}")
            elif wave_key(byid[dep]["wave"]) >= wave_key(f["wave"]):
                problems.append(f"{f['id']} (wave {f['wave']}) depends on {dep} (wave {byid[dep]['wave']}): it must be in an earlier wave")
    for i, f in enumerate(features):
        for g in features[i + 1:]:
            if wave_key(f["wave"]) != wave_key(g["wave"]):
                continue
            for a in f.get("owned", []):
                for b in g.get("owned", []):
                    if covers(a, b) or covers(b, a):
                        problems.append(f"wave {f['wave']}: {f['id']} and {g['id']} both own {a}" + ("" if a == b else f" / {b}"))
    c4path = os.path.join(app_dir, "c4-planned.json")
    if os.path.isfile(c4path):
        c4 = json.load(open(c4path, encoding="utf-8"))
        paths = [p for s in c4["model"]["systems"] for c in s["containers"] for k in c.get("components", []) for p in k.get("paths", [])]
        for f in features:
            for o in f.get("owned", []):
                if not o.startswith("Sources/"):
                    continue
                if o.endswith(("/", "+")):
                    if not any(p.startswith(o) or (p.endswith("/") and o.startswith(p)) for p in paths):
                        problems.append(f"{f['id']}: {o} has no owner in {c4path}")
                    continue
                owners = [p for p in paths if p == o or (p.endswith("/") and o.startswith(p))]
                if len(owners) != 1:
                    problems.append(f"{f['id']}: {o} has {len(owners)} owners in {c4path} {owners}")
        # Opt-in (a top-level "every_source_file_owned": true in c4-planned.json):
        # every planned Sources/ file is owned by some feature.
        if c4.get("every_source_file_owned"):
            owned = [o for f in features for o in f.get("owned", [])]
            for c in paths:
                if c.startswith("Sources/") and not c.endswith("/") and not any(covers(o, c) for o in owned):
                    problems.append(f"{c} is in {c4path} but no feature owns it")
    return problems

def cell(f, header):
    h = header.strip()
    if h == "packet":
        return f"`{f['id']}.md`" if f["_packet"] else "no packet yet"
    if h in KNOWN:
        return str(f.get(KNOWN[h], ""))
    return f.get("cells", {}).get(h, "–")

def render(app, app_dir, features, problems):
    tpl = os.path.join(app_dir, "waves.in.md")
    lines = open(tpl, encoding="utf-8").read().splitlines(keepends=True)
    out, tables = [], 0
    for line in lines:
        m = MARKER.match(line.rstrip("\n"))
        if not m:
            out.append(line)
            continue
        tables += 1
        headers = [h.strip() for h in m.group(1).split("|")]
        out.append("| " + " | ".join(headers) + " |\n")
        out.append("|" + "---|" * len(headers) + "\n")
        for f in features:
            out.append("| " + " | ".join(cell(f, h).replace("|", "\\|").replace("\n", " ") for h in headers) + " |\n")
    if tables != 1:
        problems.append(f"{tpl}: needs exactly one <!-- waves-table: ... --> line (found {tables})")
    return NOTICE.format(app=app) + "".join(out)

def apps(root, names):
    base = os.path.join(root, "docs", "blueprints")
    found = sorted(a for a in os.listdir(base) if os.path.isfile(os.path.join(base, a, "waves.in.md")))
    for n in names:
        if n not in found:
            sys.exit(f"waves: no docs/blueprints/{n}/waves.in.md")
    return [(a, os.path.join(base, a)) for a in (names or found)]

def main(argv):
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if "--root" in argv:
        i = argv.index("--root")
        root = argv[i + 1]
        del argv[i:i + 2]
    if not argv or argv[0] not in ("check", "render"):
        sys.exit("usage: scripts/waves check [APP...] | render [--check | --dry-run] [APP...] [--root DIR]")
    cmd, rest = argv[0], argv[1:]
    only_check, dry = "--check" in rest, "--dry-run" in rest
    rest = [a for a in rest if a not in ("--check", "--dry-run")]
    problems, stale = [], []
    for app, app_dir in apps(root, rest):
        found = []
        features = load_features(app_dir, found)
        if not found:
            found += check(app_dir, features)
        if cmd == "render" and not found:
            text = render(app, app_dir, features, found)
            target = os.path.join(app_dir, "features", "waves.md")
            if only_check:
                have = open(target, encoding="utf-8").read() if os.path.isfile(target) else None
                if have != text:
                    stale.append(target)
            elif not found and not dry:
                with open(target, "w", encoding="utf-8") as f:
                    f.write(text)
        problems += found
    if problems:
        print("\n".join(problems))
        print("waves: FAIL")
        return 1
    if stale:
        print("\n".join(f"{t}: differs from its data (run scripts/waves render; on dev the generated workflow does)" for t in stale))
        return 1
    print("waves: OK")
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
