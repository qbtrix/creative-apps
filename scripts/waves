#!/usr/bin/env python3
# scripts/waves: every app's feature waves as data, their checks, and the
# waves.md each app's features folder shows. Stdlib Python 3 only (macOS ships
# it; on Ubuntu: apt-get install -y python3). It generalizes the Halo
# (waves.py) and Library (waves.json, check_waves.py) checks to every app.
#
# Data: one file per feature, docs/blueprints/<app>/features/<feature>.wave.json,
# next to its packet <feature>.md. A lead marking its feature built edits only
# its own file (status, feature_issue), so leads never conflict. Fields:
#   title          the feature's one-line name (the table's "feature" cell)
#   wave           its wave label: 1, "0a", "W2"; sorted by prefix, number, suffix.
#                  A cross-app track numbers its own waves with a prefix
#                  (shell parity's SP1 to SP3, ordered by
#                  docs/blueprints/suite/features/shell-parity-waves.md)
#   order          optional integer, the row order inside a wave (then by id)
#   status         planned | building | built
#   feature_issue  "#777", or "file when ready" until it is filed
#   covers, waits_on   the table cells, as text
#   depends        optional feature ids it waits on: each must be in an earlier wave
#   owned          required, never empty: the files and globs its packet's task
#                  table owns (a feature without a packet: what its blueprint's
#                  waves section owns). A path ending in / or + covers every path
#                  under or starting with it. Two features in one wave never own
#                  the same path (with slices, the slice rule below). Never a generated file (docs/c4/model.json, a
#                  waves.md): own the C4 part or the .wave.json instead.
#   journeys       required: the XCUITest journeys that prove it, each
#                  "<Class>.<testMethod>" (HaloJourneyTests.testRenderFrame), as
#                  its packet names them. Empty only with "journeys_none": the
#                  reason (Model-only, no packet yet, ...). Belt's blueprint view
#                  joins features to C4 components and journeys through these two.
#   C4             with "owned_files_planned": true (Halo) or
#                  "every_source_file_owned": true (Library) at the top of
#                  docs/blueprints/<app>/c4-planned.json, every owned Sources/ file
#                  has exactly one owner there (a file, a folder or a glob, as
#                  scripts/ci matches them); with the second, every planned
#                  Sources/ file also needs a feature that owns it.
#   slices         optional (contract-first packets, Design first): the feature's
#                  units of done, each {"id", "behavior" (one sentence), "tasks"
#                  (2 to 5 task ids, each in one slice), "journeys" (journey ids,
#                  at least one), "owned" (its tasks' files; together exactly the
#                  feature's "owned"), "waits" ({what: [its tasks that wait]}),
#                  "ui" (optional, true or false: true for a slice that changes
#                  Sources/*App/ or Sources/SuiteUI/, which then takes the feel
#                  gate and a Mac finisher pass, docs/factory/lead.md rules 15, 17)}.
#                  A waits key is a feature id (all its slices), "<feature>:<slice>"
#                  or a slice of the same feature. Slice waits carry no wave rule:
#                  they say when a task may start, so a slice can wait on a
#                  contract slice of a feature in the same wave or another track.
#                  With slices, a path may be owned twice only when one owner runs
#                  after the other: two slices (of any features) that own the same
#                  path need a chain of waits or depends between them, and the
#                  waits have no cycle. Features without slices keep the
#                  same-wave rule.
#   ui_slice       optional, with slices: "none" for a feature with no screen
#                  (Model-only), with its reason in "ui_slice_reason". Without it,
#                  a feature with slices that isn't built needs a "ui": true slice
#                  whose waits name no slice of its own feature but the first (the
#                  contract slice), so its screen runs on the fakes in parallel with
#                  the logic slices (docs/factory/lead.md rule 18). A miss prints a
#                  "warning:" line and still exits 0 for now.
#   cells          optional {"column header": "text"} for an app's extra columns
#   anything else (notes, quality, ...) is kept for the blueprint's own
#   generators (library's gen_section8.py reads them) and ignored here.
#
# Prose: docs/blueprints/<app>/waves.in.md, hand-written blueprint prose with
# one marker line naming the table's columns, for example
#   <!-- waves-table: wave | feature | packet | covers | waits on | feature issue | status -->
# The marker becomes the table. Known columns read the fields above ("feature"
# is title, "packet" is `<id>.md` or "no packet yet"); any other column reads cells.
# docs/blueprints/<app>/features/waves.md is generated: on dev the generated
# workflow (.github/workflows/generated.yml) prints and commits it, and PRs never
# edit it (the lane's PROTECTED list). Edit the data file or waves.in.md instead.
#
#   scripts/waves check [APP...]          the data checks; prints one line per problem
#   scripts/waves render [APP...]         write each app's features/waves.md
#   scripts/waves render --check [APP...] exit 1 if a committed waves.md differs
#   scripts/waves render --dry-run [APP...]  check and print, writing nothing (scripts/ci)
#   scripts/waves render --guard [APP...] write, except a waves.md whose last commit
#                                         (git) left it different from that commit's
#                                         own data: a direct edit. That file is left
#                                         as is, named with its commit, and the run
#                                         exits 2 (the Generated workflow's guard
#                                         while PRs that edit waves.md can still merge)
#   --root DIR                            the repo root (default: this script's parent)
# With no APP, every docs/blueprints/<app>/ that has a waves.in.md.
import fnmatch, json, os, re, sys

KNOWN = {"wave": "wave", "feature": "title", "covers": "covers", "waits on": "waits_on",
         "feature issue": "feature_issue", "status": "status"}
STATUSES = ("planned", "building", "built")
MARKER = re.compile(r"^<!-- waves-table: (.+?) -->$")
NOTICE = ("<!-- Generated by scripts/waves from docs/blueprints/{app}/waves.in.md and\n"
          "     docs/blueprints/{app}/features/*.wave.json. Edit those, never this file. -->\n")

def wave_key(w):
    """Sorts a wave label by its prefix, then its number, then its suffix: 0a < 0b < 1,
    W0 < W3, and a cross-app track's labels (SP1, SP2: shell parity) after the
    app's own waves."""
    m = re.match(r"(\D*)(\d+)(.*)", str(w))
    return (m.group(1), int(m.group(2)), m.group(3)) if m else ("~", 0, str(w))

def load_features(app_dir, problems):
    folder = os.path.join(app_dir, "features")
    out = []
    for fn in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
        if not fn.endswith(".wave.json"):
            continue
        path = os.path.join(folder, fn)
        try:
            f = json.load(open(path, encoding="utf-8"))
        except ValueError as e:
            problems.append(f"{path}: not valid JSON ({e})")
            continue
        if not isinstance(f, dict):
            problems.append(f"{path}: not a JSON object")
            continue
        f["id"] = fn[: -len(".wave.json")]
        f["_path"] = path
        f["_packet"] = os.path.isfile(os.path.join(folder, f["id"] + ".md"))
        out.append(f)
    return sorted(out, key=lambda f: (wave_key(f.get("wave")), f.get("order", 0) if isinstance(f.get("order"), int) else 0, f["id"]))

def owns(p, f):
    """A C4 paths entry owns a file as scripts/ci matches it: the file itself, a
    folder prefix (with or without a trailing /) or a glob."""
    return f == p or f.startswith(p.rstrip("/") + "/") or fnmatch.fnmatchcase(f, p)

def covers(a, b):
    return a == b or (a.endswith(("/", "+")) and b.startswith(a))

def check_slices(features, byid):
    """The slice checks: shape, waits that resolve, no cycle, and no path owned by two
    slices (or a slice and a feature without slices) that could run at the same time."""
    problems, nodes, edges = [], {}, {}
    text = lambda x: isinstance(x, str) and x
    texts = lambda x: isinstance(x, list) and all(text(y) for y in x)
    for f in features:
        sl = f.get("slices")
        if sl is None:
            nodes[(f["id"], None)] = f.get("owned", [])
            continue
        if not (isinstance(sl, list) and sl and all(isinstance(s, dict) for s in sl)):
            problems.append(f"{f['id']}: \"slices\" must be a non-empty list of objects")
            continue
        seen, tasks = set(), set()
        for s in sl:
            sid = s.get("id")
            name = f"{f['id']}:{sid}"
            if not text(sid) or sid in seen:
                problems.append(f"{f['id']}: every slice needs a unique text \"id\" ({sid!r})")
                continue
            seen.add(sid)
            if not text(s.get("behavior")):
                problems.append(f"{name}: needs a one-sentence \"behavior\"")
            if not texts(s.get("tasks")) or not 2 <= len(s["tasks"]) <= 5:
                problems.append(f"{name}: \"tasks\" must list 2 to 5 task ids")
            if texts(s.get("tasks")):
                for t in s["tasks"]:
                    if t in tasks:
                        problems.append(f"{name}: task {t} is in two slices")
                    tasks.add(t)
            for k in ("journeys", "owned"):
                if not texts(s.get(k)) or not s[k]:
                    problems.append(f"{name}: \"{k}\" must be a non-empty list of text")
            if not isinstance(s.get("waits", {}), dict):
                problems.append(f"{name}: \"waits\" must map what it waits on to its tasks that wait")
            if not isinstance(s.get("ui", False), bool):
                problems.append(f"{name}: \"ui\" must be true or false")
            nodes[(f["id"], sid)] = s.get("owned", []) if texts(s.get("owned")) else []
        union = {o for s in sl if texts(s.get("owned")) for o in s["owned"]}
        if union != set(f.get("owned", [])):
            problems.append(f"{f['id']}: the slices' \"owned\" must together be the feature's \"owned\""
                            f" (only in slices: {sorted(union - set(f.get('owned', [])))};"
                            f" only in the feature: {sorted(set(f.get('owned', [])) - union)})")
    every = lambda fid: [n for n in nodes if n[0] == fid]
    for f in features:
        deps = [n for d in f.get("depends", []) if d in byid for n in every(d)]
        for n in every(f["id"]):
            edges[n] = list(deps)
        for s in f.get("slices") or []:
            if not isinstance(s, dict) or (f["id"], s.get("id")) not in nodes or not isinstance(s.get("waits", {}), dict):
                continue
            name = f"{f['id']}:{s['id']}"
            for key, who in s.get("waits", {}).items():
                fid, _, sid = key.rpartition(":")
                if not fid:
                    fid, sid = (key, None) if key in byid else (f["id"], key)
                target = every(fid) if sid is None else [(fid, sid)]
                if fid not in byid or (sid is not None and (fid, sid) not in nodes) or (fid, sid) == (f["id"], s["id"]):
                    problems.append(f"{name} waits on unknown {key}")
                    continue
                if not (texts(who) and who and set(who) <= set(s.get("tasks") or [])):
                    problems.append(f"{name}: waits[\"{key}\"] must list tasks of this slice")
                edges[(f["id"], s["id"])] += target
    reach, state = {}, {}
    def walk(n):
        if state.get(n) == 1:
            problems.append(f"waits go round in a cycle through {n[0]}" + (f":{n[1]}" if n[1] else ""))
            return set()
        if n not in reach:
            state[n] = 1
            reach[n] = {m for e in edges.get(n, []) for m in ({e} | walk(e))}
            state[n] = 2
        return reach[n]
    for n in nodes:
        walk(n)
    label = lambda n: n[0] + (f":{n[1]}" if n[1] else "")
    keys = list(nodes)
    for i, a in enumerate(keys):
        for b in keys[i + 1:]:
            if (a[1] is None and b[1] is None) or b in reach.get(a, ()) or a in reach.get(b, ()):
                continue
            hit = next(((x, y) for x in nodes[a] for y in nodes[b] if covers(x, y) or covers(y, x)), None)
            if hit:
                problems.append(f"{label(a)} and {label(b)} can run at once and both own {hit[0]}"
                                + ("" if hit[0] == hit[1] else f" / {hit[1]}") + ": one must wait on the other")
    return problems

def check_ui_slice(app, features):
    """lead.md rule 18: a sliced feature's UI slice waits only on its own contract slice.
    Warnings for now; built features are exempt (their packets aren't re-sliced)."""
    out = []
    ids = {g["id"] for g in features}
    for f in features:
        sl = f.get("slices")
        if not sl or f.get("status") == "built":
            continue
        name = f"warning: {app}/{f['id']}"
        if "ui_slice" in f:
            if f["ui_slice"] != "none":
                out.append(f"{name}: \"ui_slice\" can only be \"none\"")
            elif not (isinstance(f.get("ui_slice_reason"), str) and f["ui_slice_reason"]):
                out.append(f"{name}: \"ui_slice\": \"none\" needs its reason in \"ui_slice_reason\"")
            continue
        first = sl[0]["id"]
        def own(key):
            fid, _, sid = key.rpartition(":")
            if not fid:
                fid, sid = (key, None) if key in ids else (f["id"], key)
            return fid == f["id"] and sid != first
        if not any(s.get("ui") is True and not any(own(k) for k in s.get("waits", {})) for s in sl):
            out.append(f"{name}: no \"ui\": true slice that waits only on its contract slice {first}"
                       f" (or \"ui_slice\": \"none\" with a \"ui_slice_reason\"); lead.md rule 18")
    return out

def check(app_dir, features):
    problems = []
    byid = {f["id"]: f for f in features}
    for f in features:
        p = f["_path"]
        for k in ("title", "covers", "waits_on", "feature_issue"):
            if not isinstance(f.get(k), str) or not f[k]:
                problems.append(f"{p}: needs a text \"{k}\"")
        root = os.path.dirname(os.path.dirname(os.path.dirname(app_dir)))
        rel = os.path.relpath(f["_path"], root)
        source = (f"its packet {rel[:-len('.wave.json')]}.md" if f["_packet"]
                  else "its blueprint's waves section (no packet yet)")
        if not isinstance(f.get("owned"), list) or not f["owned"]:
            problems.append(f"{f['id']}: needs \"owned\", the files and globs {source} owns ({rel})")
        for o in (f["owned"] if isinstance(f.get("owned"), list) else []):
            if o == "docs/c4/model.json" or re.fullmatch(r"docs/blueprints/[^/]+/features/waves\.md", str(o)):
                problems.append(f"{f['id']}: owns the generated {o}; own its source instead (a part in docs/c4/parts/, or this .wave.json) ({rel})")
        j = f.get("journeys")
        if not isinstance(j, list) or not all(isinstance(x, str) and re.fullmatch(r"[A-Z]\w*\.test\w+", x) for x in j):
            problems.append(f"{f['id']}: needs \"journeys\", a list of \"<Class>.<testMethod>\" XCUITests from {source} ({rel})")
        elif not j and not (isinstance(f.get("journeys_none"), str) and f["journeys_none"]):
            problems.append(f"{f['id']}: \"journeys\" is empty; name the XCUITests {source} names, or say why there are none in \"journeys_none\" ({rel})")
        if not isinstance(f.get("wave"), (int, str)) or isinstance(f.get("wave"), bool):
            problems.append(f"{p}: needs a \"wave\" (a number or a label like \"0a\")")
        if f.get("status") not in STATUSES:
            problems.append(f"{p}: \"status\" must be one of {', '.join(STATUSES)}")
        if "order" in f and (not isinstance(f["order"], int) or isinstance(f["order"], bool)):
            problems.append(f"{p}: \"order\" must be an integer")
        for k in ("depends", "owned", "journeys"):
            if k in f and not (isinstance(f[k], list) and all(isinstance(x, str) for x in f[k])):
                problems.append(f"{p}: \"{k}\" must be a list of text")
        if "cells" in f and not (isinstance(f["cells"], dict) and all(isinstance(v, str) for v in f["cells"].values())):
            problems.append(f"{p}: \"cells\" must map column headers to text")
    if problems:
        return problems
    for f in features:
        for dep in f.get("depends", []):
            if dep not in byid:
                problems.append(f"{f['id']} depends on unknown feature {dep}")
            elif wave_key(byid[dep]["wave"]) >= wave_key(f["wave"]):
                problems.append(f"{f['id']} (wave {f['wave']}) depends on {dep} (wave {byid[dep]['wave']}): it must be in an earlier wave")
    problems += check_slices(features, byid)
    for i, f in enumerate(features):
        for g in features[i + 1:]:
            if wave_key(f["wave"]) != wave_key(g["wave"]) or "slices" in f or "slices" in g:
                continue
            for a in f.get("owned", []):
                for b in g.get("owned", []):
                    if covers(a, b) or covers(b, a):
                        problems.append(f"wave {f['wave']}: {f['id']} and {g['id']} both own {a}" + ("" if a == b else f" / {b}"))
    c4path = os.path.join(app_dir, "c4-planned.json")
    c4 = json.load(open(c4path, encoding="utf-8")) if os.path.isfile(c4path) else {}
    if c4.get("owned_files_planned") or c4.get("every_source_file_owned"):
        paths = [p for s in c4["model"]["systems"] for c in s["containers"] for k in c.get("components", []) for p in k.get("paths", [])]
        for f in features:
            for o in f.get("owned", []):
                if not o.startswith("Sources/"):
                    continue
                if o.endswith(("/", "+")):
                    if not any(p.startswith(o) or owns(p, o) for p in paths):
                        problems.append(f"{f['id']}: {o} has no owner in {c4path}")
                    continue
                owners = [p for p in paths if owns(p, o)]
                if len(owners) != 1:
                    problems.append(f"{f['id']}: {o} has {len(owners)} owners in {c4path} {owners}")
        # Opt-in (a top-level "every_source_file_owned": true in c4-planned.json):
        # every planned Sources/ file is owned by some feature.
        if c4.get("every_source_file_owned"):
            owned = [o for f in features for o in f.get("owned", [])]
            for c in paths:
                if c.startswith("Sources/") and not c.endswith("/") and not any(covers(o, c) for o in owned):
                    problems.append(f"{c} is in {c4path} but no feature owns it")
    return problems

def cell(f, header):
    h = header.strip()
    if h == "packet":
        return f"`{f['id']}.md`" if f["_packet"] else "no packet yet"
    if h in KNOWN:
        return str(f.get(KNOWN[h], ""))
    return f.get("cells", {}).get(h, "–")

def render(app, app_dir, features, problems):
    tpl = os.path.join(app_dir, "waves.in.md")
    lines = open(tpl, encoding="utf-8").read().splitlines(keepends=True)
    out, tables = [], 0
    for line in lines:
        m = MARKER.match(line.rstrip("\n"))
        if not m:
            out.append(line)
            continue
        tables += 1
        headers = [h.strip() for h in m.group(1).split("|")]
        out.append("| " + " | ".join(headers) + " |\n")
        out.append("|" + "---|" * len(headers) + "\n")
        for f in features:
            out.append("| " + " | ".join(cell(f, h).replace("|", "\\|").replace("\n", " ") for h in headers) + " |\n")
    if tables != 1:
        problems.append(f"{tpl}: needs exactly one <!-- waves-table: ... --> line (found {tables})")
    return NOTICE.format(app=app) + "".join(out)

def hand_edit(root, app):
    """Why the committed waves.md looks hand-edited, or None: None when the last commit
    that touched it left it equal to the render of that commit's own data."""
    import subprocess, tarfile, io, tempfile
    rel = f"docs/blueprints/{app}"
    git = lambda *a: subprocess.run(["git", "-C", root, *a], capture_output=True, check=True).stdout
    line = git("log", "-1", "--format=%H %s", "--", f"{rel}/features/waves.md").decode().strip()
    if not line:
        return None  # never committed: nothing to lose
    sha, subject = line.split(" ", 1)
    with tempfile.TemporaryDirectory() as tmp:
        archive = tarfile.open(fileobj=io.BytesIO(git("archive", sha, rel)))
        try:
            archive.extractall(tmp, filter="data")
        except TypeError:  # Python before 3.12 (macOS's 3.9): our own git archive
            archive.extractall(tmp)
        app_dir = os.path.join(tmp, rel)
        found = []
        if os.path.isfile(os.path.join(app_dir, "waves.in.md")):
            text = render(app, app_dir, load_features(app_dir, found), found)
            if not found and open(os.path.join(app_dir, "features", "waves.md"), encoding="utf-8").read() == text:
                return None
    return f"edited directly by {sha[:7]} ({subject})"

def apps(root, names):
    base = os.path.join(root, "docs", "blueprints")
    found = sorted(a for a in os.listdir(base) if os.path.isfile(os.path.join(base, a, "waves.in.md")))
    for n in names:
        if n not in found:
            sys.exit(f"waves: no docs/blueprints/{n}/waves.in.md")
    return [(a, os.path.join(base, a)) for a in (names or found)]

def main(argv):
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if "--root" in argv:
        i = argv.index("--root")
        root = argv[i + 1]
        del argv[i:i + 2]
    if not argv or argv[0] not in ("check", "render"):
        sys.exit("usage: scripts/waves check [APP...] | render [--check | --dry-run | --guard] [APP...] [--root DIR]")
    cmd, rest = argv[0], argv[1:]
    only_check, dry, guard = "--check" in rest, "--dry-run" in rest, "--guard" in rest
    rest = [a for a in rest if a not in ("--check", "--dry-run", "--guard")]
    problems, stale, edited, warnings = [], [], [], []
    for app, app_dir in apps(root, rest):
        found = []
        features = load_features(app_dir, found)
        if not found:
            found += check(app_dir, features)
        if not found:  # ponytail: a warning until the open packets are re-sliced, then add to found
            warnings += check_ui_slice(app, features)
        if cmd == "render" and not found:
            text = render(app, app_dir, features, found)
            target = os.path.join(app_dir, "features", "waves.md")
            if only_check:
                have = open(target, encoding="utf-8").read() if os.path.isfile(target) else None
                if have != text:
                    stale.append(target)
            elif not found and not dry:
                have = open(target, encoding="utf-8").read() if os.path.isfile(target) else None
                why = hand_edit(root, app) if guard and have != text else None
                if why:
                    edited.append(f"{os.path.relpath(target, root)}: {why}; left as is")
                elif have != text:
                    with open(target, "w", encoding="utf-8") as f:
                        f.write(text)
        problems += found
    if warnings:
        print("\n".join(warnings))
    if problems:
        print("\n".join(problems))
        print("waves: FAIL")
        return 1
    if edited:
        print("\n".join(edited))
        print("waves: a waves.md was edited directly; move its change into the feature's .wave.json or waves.in.md")
        return 2
    if stale:
        print("\n".join(f"{t}: differs from its data (run scripts/waves render; on dev the generated workflow does)" for t in stale))
        return 1
    print("waves: OK")
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
