#!/usr/bin/env python3
# scripts/jobs: each app's real jobs as data, their checks, and the jobs.md
# that shows them. A real job is a task a person does with an app, written as
# task -> observable outcome, with the trap a reviewer hits first and where its
# check runs. The done rule built on them: docs/factory/packets.md (Jobs) and
# docs/factory/lead.md rule 21. Stdlib Python 3 only.
#
# Data: docs/blueprints/<app>/jobs.json for photo, design, flare, halo and
# library, and docs/blueprints/suite/jobs.json for the cross-cutting set. One
# object keyed by job id (plus an optional "$comment"), so scripts/merge-json
# merges two PRs that add different jobs. Fields, all required:
#   id           RJ-<P|D|F|H|L|X><nn>, the letter matching the file's app
#                (X is suite); the same as its key; never reused
#   app          photo | design | flare | halo | library | suite (the folder)
#   weight       high | med | low (usage weight 3, 2, 1)
#   job          the task, one sentence
#   outcome      what a check observes when the job is done (the assertion)
#   needs        feature ids from docs/blueprints/suite/feature-map.json (S11,
#                E10, photo/photo-crop); every one must be a row there. Empty
#                only with needs_note saying why (no row in the plan yet)
#   needs_note   optional text: the need as written, or why there is no row
#   closes_with  the feature-map id whose packet must make the job pass (one of
#                needs; Belt joins on it), or null when needs is empty
#   trap         what a reviewer hits first; its check must catch it
#   run          C (CLI on Linux) | Cm (CLI headless on macOS) | J (UI journey)
#   baseline     pass | partial | fail | unknown: the hand estimate when the job
#                was added. The live status comes from the nightly results, never
#                this file
#   since        YYYY-MM-DD the job was added
#   sources      URLs the job comes from, or "captain"; at least one
# Optional: retired (the reason; a retired job keeps its row and its id),
# waits_on (the task id its check waits on), test (its .agjob), added_by.
#
# docs/blueprints/<app>/jobs.md is generated: on dev the Generated workflow
# (.github/workflows/generated.yml) prints and commits it, and PRs never edit it
# (the lane's PROTECTED list). There is no guard for a direct edit: render
# overwrites it.
#
#   scripts/jobs check [APP...]               the checks; one line per problem
#   scripts/jobs render [APP...]              write each app's jobs.md
#   scripts/jobs render --check [APP...]      exit 1 if a jobs.md differs from its data
#   scripts/jobs render --dry-run [APP...]    check and render, writing nothing (scripts/ci)
#   --root DIR                                the repo root (default: this script's parent)
# With no APP, every docs/blueprints/<app>/jobs.json.
import json, os, re, sys

APPS = {"photo": "P", "design": "D", "flare": "F", "halo": "H", "library": "L", "suite": "X"}
NAMES = {"photo": "Photo", "design": "Design", "flare": "Flare", "halo": "Halo", "library": "Library",
         "suite": "Suite and cross-cutting"}
REQUIRED = ("id", "app", "weight", "job", "outcome", "needs", "closes_with", "trap", "run", "baseline",
            "since", "sources")
TEXT = ("job", "outcome", "trap")
ENUMS = {"weight": ("high", "med", "low"), "run": ("C", "Cm", "J"),
         "baseline": ("pass", "partial", "fail", "unknown")}
WEIGHT = {"high": 3, "med": 2, "low": 1}
CREDIT = {"pass": 1, "partial": 0.5, "fail": 0, "unknown": 0}
NOTICE = ("<!-- Generated by scripts/jobs from docs/blueprints/{app}/jobs.json.\n"
          "     Edit that file, never this one. -->\n")

def feature_ids(root):
    with open(os.path.join(root, "docs", "blueprints", "suite", "feature-map.json"), encoding="utf-8") as f:
        return {row["id"] for row in json.load(f)["features"]}

def check_job(app, key, j, ids):
    where = f"docs/blueprints/{app}/jobs.json {key}"
    if not isinstance(j, dict):
        return [f"{where}: not an object"]
    out = [f"{where}: missing {k}" for k in REQUIRED if k not in j]
    if out:
        return out
    m = re.fullmatch(r"RJ-([PDFHLX])(\d{2,})", str(j["id"]))
    if not m or m.group(1) != APPS[app]:
        out.append(f"{where}: id {j['id']!r} is not RJ-{APPS[app]}<nn>")
    if j["id"] != key:
        out.append(f"{where}: id {j['id']!r} differs from its key")
    if j["app"] != app:
        out.append(f"{where}: app {j['app']!r} is not {app!r} (the folder)")
    for k, allowed in ENUMS.items():
        if j[k] not in allowed:
            out.append(f"{where}: {k} {j[k]!r} is not one of {', '.join(allowed)}")
    for k in TEXT:
        if not isinstance(j[k], str) or not j[k].strip():
            out.append(f"{where}: {k} is empty")
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", str(j["since"])):
        out.append(f"{where}: since {j['since']!r} is not YYYY-MM-DD")
    needs = j["needs"]
    if not isinstance(needs, list):
        out.append(f"{where}: needs is not a list")
        needs = []
    for n in needs:
        if n not in ids:
            out.append(f"{where}: needs {n!r} is not a feature id in docs/blueprints/suite/feature-map.json")
    note = j.get("needs_note")
    if not needs and not (isinstance(note, str) and note.strip()):
        out.append(f"{where}: needs is empty; name the feature-map row, or say why there is none in needs_note")
    c = j["closes_with"]
    if c is None:
        if needs:
            out.append(f"{where}: closes_with is null but needs names a row; pick the one whose packet makes it pass")
    elif c not in needs:
        out.append(f"{where}: closes_with {c!r} is not one of its needs")
    srcs = j["sources"]
    if not isinstance(srcs, list) or not srcs:
        out.append(f"{where}: sources is empty; cite a URL or \"captain\"")
    else:
        for s in srcs:
            if s != "captain" and not re.match(r"https?://\S+$", str(s)):
                out.append(f"{where}: source {s!r} is not a URL or \"captain\"")
    return out

def load(root, app):
    path = os.path.join(root, "docs", "blueprints", app, "jobs.json")
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except ValueError as e:
        return None, [f"docs/blueprints/{app}/jobs.json: not valid JSON ({e})"]
    if not isinstance(data, dict):
        return None, [f"docs/blueprints/{app}/jobs.json: must be an object keyed by job id"]
    return {k: v for k, v in data.items() if k != "$comment"}, []

def score(jobs):
    live = [j for j in jobs if not j.get("retired")]
    total = sum(WEIGHT[j["weight"]] for j in live)
    got = sum(WEIGHT[j["weight"]] * CREDIT[j["baseline"]] for j in live)
    return (10 * got / total) if total else 0.0, live

def cell(s):
    return str(s).replace("|", "\\|").replace("\n", " ")

def render(app, jobs):
    def key(j):
        return int(re.search(r"\d+$", j["id"]).group())
    jobs = sorted(jobs.values(), key=key)
    sc, live = score(jobs)
    count = lambda k, v: sum(1 for j in live if j[k] == v)
    lines = [NOTICE.format(app=app), f"# {NAMES[app]}: real jobs", "",
             "Each job is a task a person does, with an outcome a check observes, the trap a reviewer hits first,",
             "and where its check runs: **C** the CLI on Linux, **Cm** the CLI headless on macOS, **J** a UI journey.",
             "**baseline** is the hand estimate when the job was added; the live status comes from the nightly run.",
             "The done rule: docs/factory/packets.md (Jobs) and docs/factory/lead.md rule 21.", "",
             f"{len(live)} jobs: {count('run', 'C')} C, {count('run', 'Cm')} Cm, {count('run', 'J')} J. "
             f"Baseline {count('baseline', 'pass')} pass, {count('baseline', 'partial')} partial, "
             f"{count('baseline', 'fail')} fail, {count('baseline', 'unknown')} unknown; "
             f"baseline score **{sc:.1f}/10** (10 × Σ weight × credit ÷ Σ weight; pass 1, partial 0.5, else 0).", "",
             "| id | job → outcome | weight | needs | closes with | baseline | trap | run | sources |",
             "|---|---|---|---|---|---|---|---|---|"]
    for j in jobs:
        needs = ", ".join(f"`{n}`" for n in j["needs"])
        if j.get("needs_note"):
            needs = f"{needs} ({cell(j['needs_note'])})" if needs else cell(j["needs_note"])
        status = f"retired: {cell(j['retired'])}" if j.get("retired") else j["baseline"]
        srcs = " ".join(s if s == "captain" else f"[{i}]({s})" for i, s in enumerate(j["sources"], 1))
        closes = f"`{j['closes_with']}`" if j["closes_with"] else "–"
        lines.append(f"| {j['id']} | {cell(j['job'])} → {cell(j['outcome'])} | {j['weight']} | {needs} | {closes} "
                     f"| {status} | {cell(j['trap'])} | {j['run']} | {srcs} |")
    return "\n".join(lines) + "\n"

def main(argv):
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if "--root" in argv:
        i = argv.index("--root")
        root = argv[i + 1]
        del argv[i:i + 2]
    if not argv or argv[0] not in ("check", "render"):
        sys.exit("usage: scripts/jobs check [APP...] | render [--check | --dry-run] [APP...] [--root DIR]")
    cmd, rest = argv[0], argv[1:]
    only_check, dry = "--check" in rest, "--dry-run" in rest
    rest = [a for a in rest if a not in ("--check", "--dry-run")]
    base = os.path.join(root, "docs", "blueprints")
    found = sorted(a for a in os.listdir(base) if os.path.isfile(os.path.join(base, a, "jobs.json")))
    problems = [f"docs/blueprints/{a}/jobs.json: {a!r} is not an app ({', '.join(APPS)})" for a in found if a not in APPS]
    for n in rest:
        if n not in found:
            problems.append(f"jobs: no docs/blueprints/{n}/jobs.json")
    ids = feature_ids(root)
    stale, total = [], 0
    for app in [a for a in (rest or found) if a in APPS and a in found]:
        jobs, bad = load(root, app)
        if jobs is not None:
            for k, j in jobs.items():
                bad += check_job(app, k, j, ids)
        problems += bad
        if bad:
            continue
        total += len(jobs)
        if cmd == "render":
            text = render(app, jobs)
            target = os.path.join(base, app, "jobs.md")
            have = open(target, encoding="utf-8").read() if os.path.isfile(target) else None
            if only_check and have != text:
                stale.append(target)
            elif not only_check and not dry and have != text:
                with open(target, "w", encoding="utf-8") as f:
                    f.write(text)
    if problems:
        print("\n".join(problems))
        print("jobs: FAIL")
        return 1
    if stale:
        print("\n".join(f"{t}: differs from its data (run scripts/jobs render; on dev the generated workflow does)" for t in stale))
        return 1
    print(f"jobs: OK ({total} jobs)")
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
