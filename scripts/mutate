#!/usr/bin/env python3
# scripts/mutate: tests the tests. It plants a known bug from a plan, runs the
# tests the plan names, and requires one of them to fail. A suite that still
# passes with the bug in place would ship that bug: the mutation ESCAPED, and
# the test is a false oracle.
#
# Plans are Tests/mutations/*.json, one per source file, named after it
# (DesignModel.LiveMarquee.json mutates Sources/DesignModel/Live/LiveMarquee.swift),
# so a plan belongs to whichever task owns that file. Each is a JSON list of
#   {"label": "the bug it plants", "file": "Sources/...", "find": "exact source",
#    "replace": "the bug", "tests": "<swift test --filter regex>"}
# `find` must occur exactly once in `file`. `tests` is a suite name, or the file
# name for free-function tests (DesignDistributeTests.swift).
#
#   scripts/mutate --validate                      every anchor resolves once; no build, for scripts/ci
#   scripts/mutate                                 run every plan
#   scripts/mutate --plan DesignModel.LiveMarquee  one plan (a name or a path)
#   scripts/mutate --plan <plan> --only "locked"   entries whose label contains the text
#
# A run refuses to start while a target file differs from HEAD, so a run that
# was killed mid-mutation is noticed rather than adopted as the original. It
# builds and runs the selected tests unmutated first (a red baseline would make
# every mutation look caught). Then per entry: write the bug; `swift build`
# (the sources; a compile error there is BROKEN, the entry plants nothing
# testable); `swift test --filter <tests>`, which builds the test targets too,
# so a test that stops compiling counts as caught (the signature pins in
# DesignDocumentTests catch drift that way); restore the file. The restore sits
# in a finally that Ctrl-C and SIGTERM reach, and the run ends by checking
# `git status` is clean for every target file.
#
# Outcomes: caught (a test failed, did not compile, or timed out), ESCAPED (all
# passed, or the filter matched no tests), BROKEN (the sources did not compile).
# Exit 0 when every entry is caught, 1 when any escaped or broke or an anchor is
# stale, 2 for a setup error (dirty file, red baseline, failed restore).
# Python 3.9+ stdlib only (the macOS Command Line Tools ship 3.9); the CLT
# Testing.framework flags mirror scripts/ci. Adapted from creative-core's scripts/mutate.
from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PLANS = ROOT / "Tests" / "mutations"
KEYS = ("label", "file", "find", "replace", "tests")
STEP_TIMEOUT = 1200  # seconds for one build or test run; a hung test counts as caught


def rel(path: Path) -> str:
    try:
        return path.relative_to(ROOT).as_posix()
    except ValueError:
        return str(path)


def plan_paths(name: str | None) -> list[Path]:
    if name is None:
        return sorted(PLANS.glob("*.json"))
    path = Path(name)
    if path.suffix != ".json":
        path = PLANS / f"{name}.json"
    return [path if path.is_absolute() else ROOT / path]


def parse_plan(path: Path, text: str) -> tuple[list[dict], list[str]]:
    """Entries of one plan, each tagged with its plan, and schema problems."""
    try:
        raw = json.loads(text)
    except ValueError as e:
        return [], [f"{rel(path)}: not valid JSON: {e}"]
    if not isinstance(raw, list):
        return [], [f"{rel(path)}: must be a JSON list of entries"]
    entries, problems = [], []
    for i, e in enumerate(raw, 1):
        bad = [k for k in KEYS if not isinstance(e, dict) or not isinstance(e.get(k), str)
               or (k != "replace" and not e[k])]
        if bad:
            problems.append(f"{rel(path)}#{i}: missing or empty {', '.join(bad)}")
            continue
        entries.append(dict(e, plan=path.stem))
    return entries, problems


def load(paths: list[Path]) -> tuple[list[dict], list[str]]:
    entries, problems = [], []
    if not paths:
        problems.append(f"no plans under {rel(PLANS)}")
    for path in paths:
        try:
            text = path.read_text(encoding="utf-8")
        except OSError as e:
            problems.append(f"{rel(path)}: {e}")
            continue
        found, bad = parse_plan(path, text)
        entries += found
        problems += bad
    return entries, problems


def anchor_problem(e: dict) -> str | None:
    try:
        text = (ROOT / e["file"]).read_bytes().decode("utf-8")
    except OSError:
        return f"no such file {e['file']}"
    count = text.count(e["find"])
    if count != 1:
        return f"find occurs {count} times in {e['file']}, needs exactly 1"
    if e["find"] == e["replace"]:
        return "replace equals find, so it plants nothing"
    return None


def validate(args) -> int:
    entries, problems = load(plan_paths(args.plan))
    problems += [f"{e['plan']}: {e['label']}: {p}" for e in entries if (p := anchor_problem(e))]
    if problems:
        print("\n".join(problems))
        print(f"\nFAIL: {len(problems)} problem(s). A stale anchor plants nothing, so its plan"
              " reads as covered while proving nothing. Repoint `find` at the code as it is now,"
              " keeping the bug its label names.")
        return 1
    print(f"OK: {len(entries)} anchors in {len({e['plan'] for e in entries})} plan(s) resolve exactly once.")
    return 0


def git(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True)


def swift_flags() -> list[str]:
    """scripts/ci's flags for a Mac with only the Command Line Tools."""
    clt = "/Library/Developer/CommandLineTools/Library/Developer"
    if sys.platform != "darwin" or not os.path.isdir(f"{clt}/Frameworks/Testing.framework"):
        return []
    selected = subprocess.run(["xcode-select", "-p"], capture_output=True, text=True).stdout
    if not selected.startswith("/Library/Developer/CommandLineTools"):
        return []
    return ["-Xswiftc", "-F", "-Xswiftc", f"{clt}/Frameworks", "-Xlinker", "-F", "-Xlinker", f"{clt}/Frameworks",
            "-Xlinker", "-rpath", "-Xlinker", f"{clt}/Frameworks", "-Xlinker", "-rpath", "-Xlinker", f"{clt}/usr/lib"]


def run(cmd: list[str]) -> tuple[int | None, str]:
    """(exit code, or None on timeout; output)."""
    proc = subprocess.Popen(cmd, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, errors="replace", start_new_session=True)
    try:
        out, _ = proc.communicate(timeout=STEP_TIMEOUT)
        return proc.returncode, out
    except subprocess.TimeoutExpired:
        return None, stop(proc)
    except BaseException:
        stop(proc)
        raise


def stop(proc: subprocess.Popen) -> str:
    """SIGINT first: SwiftPM starts compilers and the test runner in their own
    process groups and only stops them on its interrupt. SIGKILL if it lingers."""
    for sig in (signal.SIGINT, signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            pass
        try:
            return proc.communicate(timeout=15)[0] or ""
        except subprocess.TimeoutExpired:
            continue
    return ""


def no_tests_ran(out: str) -> bool:
    # XCTest's "Executed 0 tests" is normal when the filter names Swift Testing tests only.
    return bool(re.search(r"No matching test cases|Test run with 0 tests", out))


def ran_tests(out: str) -> bool:
    return bool(re.search(r"Test run with \d+ tests?|Executed \d+ tests?", out))


def first_error(out: str) -> str:
    m = re.search(r"^(\S+?):(\d+):\d+: error: (.*)$", out, re.M)
    return f"{Path(m.group(1)).name}:{m.group(2)}: {m.group(3)}" if m else ""


def tail(out: str, lines: int = 30) -> str:
    return "\n".join(out.rstrip().splitlines()[-lines:])


def mutate(args) -> int:
    entries, problems = load(plan_paths(args.plan))
    if problems:
        print("\n".join(problems) + "\nRun scripts/mutate --validate.")
        return 1
    if args.only:
        entries = [e for e in entries if args.only.lower() in e["label"].lower()]
        if not entries:
            print(f"No label contains {args.only!r}; nothing ran.")
            return 1
    if not entries:
        print("No mutations in the plan(s); nothing to run.")
        return 0
    bad = [f"{e['plan']}: {e['label']}: {p}" for e in entries if (p := anchor_problem(e))]
    if bad:
        print("\n".join(bad) + "\nRun scripts/mutate --validate.")
        return 1
    files = sorted({e["file"] for e in entries})
    dirty = git("status", "--porcelain", "--", *files).stdout.strip()
    if dirty:
        print(f"REFUSING: target files differ from HEAD:\n{dirty}\n"
              "A killed run leaves its mutation in place, and running now would adopt it as the\n"
              "original. Check `git diff`; restore a leftover mutation with `git checkout -- <file>`,\n"
              "or commit your own edits first.")
        return 2

    flags = swift_flags()
    build = ["swift", "build", *flags]
    test = ["swift", "test", *flags, "--filter"]
    print(f"{len(entries)} mutation(s) in {len({e['plan'] for e in entries})} plan(s) across {len(files)} file(s)")
    start = time.monotonic()
    code, out = run(build)
    if code != 0:
        print(f"{tail(out)}\nBaseline build failed; fix the build first.")
        return 2
    union = "|".join(sorted({e["tests"] for e in entries}))
    code, out = run(test + [union])
    if code != 0 or no_tests_ran(out) or not ran_tests(out):
        print(f"{tail(out)}\nBaseline: the selected tests fail or match nothing WITHOUT any mutation,"
              " so no result would mean anything.")
        return 2
    print(f"baseline build and tests green in {time.monotonic() - start:.0f}s\n")

    originals = {f: (ROOT / f).read_bytes() for f in files}
    # A shell starts background jobs with SIGINT ignored; take it back so Ctrl-C
    # and a CI cancel both reach the finally below.
    signal.signal(signal.SIGINT, signal.default_int_handler)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    for e in entries:
        e["outcome"] = None
    try:
        for e in entries:
            t0 = time.monotonic()
            path = ROOT / e["file"]
            try:
                path.write_bytes(originals[e["file"]].decode("utf-8")
                                 .replace(e["find"], e["replace"], 1).encode("utf-8"))
                code, out = run(build)
                if code != 0:
                    outcome, why = "BROKEN", f"sources do not compile: {first_error(out) or 'see swift build'}" if code else "build timed out"
                else:
                    code, out = run(test + [e["tests"]])
                    failed = re.search(r"✘ Test (?!run with)(\S+)", out) or re.search(r"Test Case '-\[\S+ (\S+)\]' failed", out)
                    if code is None:
                        outcome, why = "caught", "tests timed out"
                    elif code != 0 and not ran_tests(out):
                        why = first_error(out)
                        outcome, why = "caught", f"tests do not compile: {why}" if why else "the test process died"
                    elif code != 0:
                        outcome, why = "caught", f"by {failed.group(1)}" if failed else "tests failed"
                    else:
                        outcome = "ESCAPED"
                        why = "filter matched no tests" if no_tests_ran(out) else "all tests passed"
            finally:
                path.write_bytes(originals[e["file"]])
            e["outcome"] = outcome
            print(f"  {outcome:8} {e['plan']}: {e['label']} ({why}, {time.monotonic() - t0:.0f}s)", flush=True)
    finally:
        for f, data in originals.items():
            (ROOT / f).write_bytes(data)
        leftover = git("status", "--porcelain", "--", *files).stdout.strip()
        if leftover:
            print(f"\nRESTORE FAILED, these files still differ from HEAD:\n{leftover}\n"
                  "Restore them with `git checkout -- <file>` before anything else.")
            sys.exit(2)

    caught = sum(e["outcome"] == "caught" for e in entries)
    print(f"\nscore: {caught}/{len(entries)} caught in {(time.monotonic() - start) / 60:.1f} min")
    for plan in sorted({e["plan"] for e in entries}):
        mine = [e for e in entries if e["plan"] == plan]
        print(f"  {plan}: {sum(e['outcome'] == 'caught' for e in mine)}/{len(mine)}")
    for e in entries:
        if e["outcome"] != "caught":
            print(f"  {e['outcome']} {e['plan']}: {e['label']}\n    {e['file']}  tests: {e['tests']}")
    if caught < len(entries):
        print("\nAn escape is a bug the suite would ship: add the test that catches it, or drop the\n"
              "entry if the change cannot alter behavior. Fix a BROKEN entry's replace.")
        return 1
    return 0


def main() -> int:
    p = argparse.ArgumentParser(description="Plant known bugs and require a test to catch each one.")
    p.add_argument("--validate", action="store_true", help="only check every find resolves exactly once; no build")
    p.add_argument("--plan", help="one plan: a name (DesignModel.LiveMarquee) or a path")
    p.add_argument("--only", help="entries whose label contains TEXT")
    args = p.parse_args()
    return validate(args) if args.validate else mutate(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:  # the sources were restored on the way out
        sys.exit(130)
