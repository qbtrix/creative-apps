<?xml version="1.0" encoding="UTF-8"?>
<!--
JourneyRunner.entitlements: what every journey bundle's sandboxed runner (<X>JourneyTests-Runner.app) may do beyond
Xcode's own runner entitlements, which Xcode merges these into (codesign's entitlements dump of a built runner
shows them). Test targets only; the apps' own signing never reads this file.
- connect to an app's live socket, ~/Library/Application Support/AfterGlow/live/<app>-<pid>.sock (LiveCommandChannel),
  so Journey+Live.swift can send `live/run`. Only that file name in that folder; the home differs per machine, so it
  is a regex on the tail of the path.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.temporary-exception.sbpl</key>
	<array>
		<string>(allow network-outbound (remote unix-socket (regex #"/Library/Application Support/AfterGlow/live/[a-z]+-[0-9]+\.sock$")))</string>
	</array>
</dict>
</plist>
