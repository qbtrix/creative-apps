{
  "version": 1,
  "app": "photo",
  "why": "RJ-P19: selects the top half of a grey image and fills it with a deep-to-pale blue sky gradient, then checks the sky is smooth (dithered, no banding) and the bottom half stays grey.",
  "inputs": ["input/*.png"],
  "steps": [
    {"id": "select.rect", "params": {"x": 0, "y": 0, "width": 256, "height": 128}},
    {"id": "image.gradient", "params": {
      "type": "linear",
      "stops": [
        {"offset": 0, "r": 0.0625, "g": 0.1875, "b": 0.5625, "a": 1},
        {"offset": 1, "r": 0.75, "g": 0.875, "b": 1, "a": 1}
      ],
      "from": {"x": 128, "y": 0},
      "to": {"x": 128, "y": 128}
    }}
  ],
  "atomic": true,
  "output": {"dir": "out", "name": "{stem}-sky", "format": "png", "options": {}},
  "expect": {
    "out/grey-256-sky.png": {"pixels": {"tolerance": 2, "reference": "expected/grey-256-sky.png"}}
  },
  "platforms": ["linux", "macos"]
}
