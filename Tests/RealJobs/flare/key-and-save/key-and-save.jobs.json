{
  "version": 1,
  "app": "flare",
  "why": "Adds a layer to a blank 24-frame animation, keys its x at frames 0 and 12, and saves the .flare file.",
  "inputs": ["input/*.flare"],
  "steps": [
    {"id": "layer.add", "params": {"sceneID": "scene-1", "layer": {"id": "layer-1", "name": "Ball", "tracks": {}, "instances": [], "isVisible": true, "isLocked": false,
      "shapes": [{"closed": true, "fill": {"r": 0, "g": 0, "b": 0, "a": 1}, "points": [{"x": 0, "y": 0}, {"x": 20, "y": 0}, {"x": 20, "y": 20}, {"x": 0, "y": 20}]}]}}},
    {"id": "keyframe.set", "params": {"sceneID": "scene-1", "layerID": "layer-1", "property": "x", "keyframe": {"frame": 0, "value": 0, "easing": {"linear": {}}}}},
    {"id": "keyframe.set", "params": {"sceneID": "scene-1", "layerID": "layer-1", "property": "x", "keyframe": {"frame": 12, "value": 120, "easing": {"linear": {}}}}}
  ],
  "atomic": true,
  "output": {"dir": "out", "name": "{stem}-keyed", "format": "flare"},
  "expect": {
    "out/blank-keyed.flare": {"json": {"format": "flare", "version": 1, "document": {"symbols": [], "scenes": [{
      "id": "scene-1", "name": "Scene 1", "width": 200, "height": 100, "fps": 24, "durationFrames": 24,
      "background": {"r": 1, "g": 1, "b": 1, "a": 1}, "guides": [], "labels": {},
      "layers": [{"id": "layer-1", "name": "Ball", "instances": [], "isLocked": false, "isVisible": true,
        "shapes": [{"closed": true, "fill": {"r": 0, "g": 0, "b": 0, "a": 1}, "points": [{"x": 0, "y": 0}, {"x": 20, "y": 0}, {"x": 20, "y": 20}, {"x": 0, "y": 20}]}],
        "tracks": {"x": [{"frame": 0, "value": 0, "easing": {"linear": {}}}, {"frame": 12, "value": 120, "easing": {"linear": {}}}]}}]
    }]}}}
  },
  "platforms": ["linux", "macos"]
}
