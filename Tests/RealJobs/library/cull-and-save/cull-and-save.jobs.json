{
  "version": 1,
  "app": "library",
  "why": "Culls a four-photo shoot (rates, picks, rejects and labels) and writes its catalog file, which must equal the expected one.",
  "inputs": ["input/*.library"],
  "steps": [
    {"id": "edit.select", "params": {"ids": ["beach"]}},
    {"id": "metadata.set-rating", "params": {"stars": 4}},
    {"id": "metadata.pick", "params": {}},
    {"id": "metadata.set-label", "params": {"label": "Green"}},
    {"id": "edit.select", "params": {"ids": ["fog"]}},
    {"id": "metadata.reject", "params": {}},
    {"id": "edit.select", "params": {"ids": ["dock", "pier"]}},
    {"id": "metadata.set-rating", "params": {"stars": 2}},
    {"id": "metadata.set-label", "params": {"label": "Blue"}}
  ],
  "atomic": true,
  "output": {"dir": "out", "name": "{stem}-catalog", "format": "json", "options": {}},
  "expect": {
    "out/shoot-catalog.json": {"json": {
      "version": 1,
      "photos": [
        {"captureDate": 1760000000, "color": [0.902, 0.7843, 0.5882], "flag": "Pick", "id": "beach", "label": "Green",
         "name": "beach", "path": "images/beach.png", "pixelSize": {"height": 3, "width": 4}, "rating": 4},
        {"captureDate": 1760000060, "color": [0.3529, 0.2745, 0.1961], "flag": "None", "id": "dock", "label": "Blue",
         "name": "dock", "path": "images/dock.png", "pixelSize": {"height": 3, "width": 4}, "rating": 2},
        {"captureDate": 1760000120, "color": [0.7843, 0.7843, 0.8039], "flag": "Reject", "id": "fog",
         "name": "fog", "path": "images/fog.png", "pixelSize": {"height": 3, "width": 4}, "rating": 0},
        {"captureDate": 1760000180, "color": [0.2353, 0.3137, 0.4314], "flag": "None", "id": "pier", "label": "Blue",
         "name": "pier", "path": "images/pier.png", "pixelSize": {"height": 3, "width": 4}, "rating": 2}
      ]
    }}
  },
  "platforms": ["linux", "macos"]
}
