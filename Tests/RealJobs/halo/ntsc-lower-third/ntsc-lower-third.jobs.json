{
  "version": 1,
  "app": "halo",
  "why": "RJ-X74 (suiteui/frame-rates): From a blank project, by commands: a new 29.97 fps, 10 s composition, a text layer whose x is keyed from 0 at frame 0 to 600 at frame 299, then save. The PNG sequence render is macOS-only (the CLI refuses render.start), so the job stops at the save. The trap: the composition silently runs at 30, so frame 299 is timed at 9.967 s, not 9.977 s, and the key lands a frame early on an editor timeline. The assertion: the saved project keeps the rate as 30000/1001 with 300 frames and both keys; the render times frame 299 at 299 x 1001 / 30000 s within 1 microsecond (HaloFrameRateTests); the readout at frame 1800 of a 2 min copy is 00:01:00;02.",
  "inputs": ["input/*.halo"],
  "steps": [
    {"id": "composition.new", "params": {}},
    {"id": "composition.set-frame-rate", "params": {"num": 30000, "den": 1001}},
    {"id": "layer.new", "params": {"kind": "text"}},
    {"id": "text.set", "params": {"text": "Lower Third"}},
    {"id": "timeline.scrub", "params": {"frame": 0}},
    {"id": "inspector.toggle-animation", "params": {"property": "x"}},
    {"id": "inspector.set-property", "params": {"property": "x", "value": 0}},
    {"id": "timeline.scrub", "params": {"frame": 299}},
    {"id": "inspector.set-property", "params": {"property": "x", "value": 600}}
  ],
  "atomic": true,
  "expect": {
    "out/blank.halo": {"json": {"format": "halo", "version": 1, "project": {
      "compositions": [{"id": "comp-1", "name": "Comp 1", "width": 1920, "height": 1080, "framesPerSecond": 30,
        "frameRate": {"num": 30000, "den": 1001}, "durationFrames": 300, "playheadFrame": 299,
        "layers": [
          {"id": "comp-1-layer-1", "name": "Text 1", "kind": "text", "inFrame": 0, "outFrame": 300, "opacity": 1, "blendMode": "normal",
           "color": {"red": 0.1, "green": 0.1, "blue": 0.1},
           "text": {"string": "Lower Third", "fontSize": 72, "width": {"$linux": 475.19999999999993}, "height": {"$linux": 72}},
           "tracks": {"x": [
             {"frame": 0, "value": 0, "easing": {"linear": {}}},
             {"frame": 299, "value": 600, "easing": {"linear": {}}}]}}
        ]}],
      "selectedCompositionID": "comp-1", "selectedLayerID": "comp-1-layer-1",
      "nextCompositionNumber": 2, "nextLayerNumber": 2
    }}}
  },
  "platforms": ["linux", "macos"]
}
