{
  "version": 1,
  "app": "halo",
  "why": "Selects a card's text layer, sets its text and checks the saved project as JSON.",
  "inputs": ["input/*.halo"],
  "steps": [
    {"id": "layer.select", "params": {"id": "comp-1-layer-2"}},
    {"id": "text.set", "params": {"text": "Goodbye Halo"}}
  ],
  "atomic": true,
  "expect": {
    "out/card.halo": {"json": {"format": "halo", "version": 1, "project": {
      "compositions": [{"id": "comp-1", "name": "Card", "width": 320, "height": 180, "framesPerSecond": 24, "durationFrames": 48, "playheadFrame": 0,
        "layers": [
          {"id": "comp-1-layer-2", "name": "Title", "kind": "text", "inFrame": 0, "outFrame": 48, "opacity": 1, "blendMode": "normal",
           "color": {"red": 0.1, "green": 0.1, "blue": 0.1}, "tracks": {},
           "text": {"string": "Goodbye Halo", "fontSize": 32, "width": {"$linux": 230.39999999999998}, "height": {"$linux": 32}}},
          {"id": "comp-1-layer-1", "name": "Panel", "kind": "shape", "inFrame": 0, "outFrame": 48, "opacity": 1, "blendMode": "normal",
           "color": {"red": 0.25, "green": 0.55, "blue": 0.9}, "tracks": {},
           "rect": {"x": 0, "y": 0, "width": 320, "height": 180}}
        ]}],
      "selectedCompositionID": "comp-1", "selectedLayerID": "comp-1-layer-2",
      "nextCompositionNumber": 2, "nextLayerNumber": 3
    }}}
  },
  "platforms": ["linux", "macos"]
}
