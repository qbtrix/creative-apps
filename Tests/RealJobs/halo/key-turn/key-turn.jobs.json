{
  "version": 1,
  "app": "halo",
  "why": "RJ-H34: animates a shape's Rotation, scrubs to 12, turns it 30 degrees and doubles it about its centre with the transform commands, and checks the saved project: Rotation keys 30 at 12 over its base 0 at 0, Scale keys 2 at 12, the centre stays put.",
  "inputs": ["input/*.halo"],
  "steps": [
    {"id": "layer.select", "params": {"id": "comp-1-layer-1"}},
    {"id": "inspector.toggle-animation", "params": {"property": "rotation"}},
    {"id": "inspector.toggle-animation", "params": {"property": "scaleX"}},
    {"id": "inspector.toggle-animation", "params": {"property": "scaleY"}},
    {"id": "timeline.scrub", "params": {"frame": 12}},
    {"id": "transform.rotate", "params": {"degrees": 30}},
    {"id": "transform.scale", "params": {"sx": 2, "sy": 2, "anchor": "center"}}
  ],
  "atomic": true,
  "expect": {
    "out/one-shape.halo": {"json": {"format": "halo", "version": 1, "project": {
      "compositions": [{"id": "comp-1", "name": "Turn", "width": 320, "height": 180, "framesPerSecond": 24, "durationFrames": 48, "playheadFrame": 12,
        "layers": [
          {"id": "comp-1-layer-1", "name": "Box", "kind": "shape", "inFrame": 0, "outFrame": 48, "opacity": 1, "blendMode": "normal",
           "color": {"red": 0.9, "green": 0.4, "blue": 0.2}, "rect": {"x": 100, "y": 60, "width": 60, "height": 40},
           "tracks": {
            "rotation": [
             {"frame": 0, "value": 0, "easing": {"linear": {}}},
             {"frame": 12, "value": 30, "easing": {"linear": {}}},
             {"frame": 47, "value": 0, "easing": {"linear": {}}}],
            "scaleX": [
             {"frame": 0, "value": 1, "easing": {"linear": {}}},
             {"frame": 12, "value": 2, "easing": {"linear": {}}},
             {"frame": 47, "value": 1, "easing": {"linear": {}}}],
            "scaleY": [
             {"frame": 0, "value": 1, "easing": {"linear": {}}},
             {"frame": 12, "value": 2, "easing": {"linear": {}}},
             {"frame": 47, "value": 1, "easing": {"linear": {}}}]}}]}],
      "nextCompositionNumber": 2, "nextLayerNumber": 2, "selectedCompositionID": "comp-1", "selectedLayerID": "comp-1-layer-1"}}}
  },
  "platforms": ["linux", "macos"]
}
