    "label": "flagSets: a flag command toggles its flag off instead of setting it",
    "file": "Sources/LibraryModel/LibraryCommandCatalog.swift",
    "find": "{ _, _ in .setFlag(flag) }",
    "replace": "{ c, _ in .setFlag(c.selectedMetadata?.flag == .value(flag) ? .none : flag) }",
    "tests": "LibraryCommandCatalogTests"
  },
