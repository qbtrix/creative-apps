[
  {
    "label": "the close prompt names the wrong file for an unsaved document",
    "file": "Sources/DesignModel/DesignHistory.swift",
    "find": "documentURL?.lastPathComponent ?? \"Untitled\"",
    "replace": "documentURL?.lastPathComponent ?? \"Design\"",
    "tests": "DesignUndoTargetTests"
  },
  {
    "label": "the close prompt builds its own wording instead of the shared one",
    "file": "Sources/DesignModel/DesignHistory.swift",
    "find": "return UnsavedPrompt.message(for: name)",
    "replace": "return \"Do you want to save the changes you made to \\u{201C}\\(name)\\u{201D}?\"",
    "tests": "DesignUndoTargetTests"
  },
  {
    "label": "isDirty reads the kernel session backwards",
    "file": "Sources/DesignModel/DesignHistory.swift",
    "find": "isOpen && documentSession.isDirty",
    "replace": "isOpen && !documentSession.isDirty",
    "tests": "DesignDirtyTests"
  },
  {
    "label": "a New File swap leaves the saved marker on the old document",
    "file": "Sources/DesignModel/DesignHistory.swift",
    "find": "if swapsDocument { history.kernel.markSaved() }",
    "replace": "_ = swapsDocument",
    "tests": "DesignDirtyTests"
  },
  {
    "label": "the reverse step keeps the undone snapshot, so redo puts the old document back",
    "file": "Sources/DesignModel/DesignHistory.swift",
    "find": "DesignHistory.Revert(snapshot: snapshot, swapsDocument: step.swapsDocument",
    "replace": "DesignHistory.Revert(snapshot: step.snapshot, swapsDocument: step.swapsDocument",
    "tests": "DesignUndoTests"
  },
  {
    "label": "the save word is not the kernel session's and always reads Saved",
    "file": "Sources/DesignModel/DesignHistory.swift",
    "find": "return documentSession.stateText",
    "replace": "return \"Saved\"",
    "tests": "DesignDirtyTests"
  },
  {
    "label": "undoDropsTime: undo leaves the document's rate and length as they are",
    "file": "Sources/DesignModel/DesignHistory.swift",
    "find": "(pages, time) = (snapshot.pages, snapshot.time)\n        held.replace(with: snapshot.heldIDs)\n        (selectedPageID, selectedNodeIDs) =",
    "replace": "pages = snapshot.pages\n        held.replace(with: snapshot.heldIDs)\n        (selectedPageID, selectedNodeIDs) =",
    "tests": "DesignPlayheadTests"
  }
]
